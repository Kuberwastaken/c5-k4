{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Kuberwastaken/c5-k4/schemas/benchmark-private-s3-object-reference-v1.5.schema.json",
  "title": "Method v1.5 PRE-P1 private version-pinned S3 custody reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "bucket", "key", "version_id", "sha256", "byte_count", "retain_until_utc"],
  "properties": {
    "schema": {"const": "c5k4-method-v1.5-private-s3-object-reference-1.0"},
    "status": {"const": "PRE_P1_PRIVATE_REMOTE_REFERENCE_NOT_OPERATIONAL"},
    "bucket": {"type": "string", "minLength": 3, "maxLength": 63, "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"},
    "key": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
    "version_id": {"type": "string", "minLength": 1, "maxLength": 1024, "not": {"const": "null"}, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "byte_count": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "retain_until_utc": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
