{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Kuberwastaken/c5-k4/schemas/benchmark-target-blind-checkpoint-request-v1.5.schema.json",
  "title": "Method v1.5 target-blind controlled-harness request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "protocol_version",
    "scheduled_for_utc",
    "mode",
    "public_chain_proof_sha256",
    "public_tip_commit",
    "p1r_commit",
    "p1r_activation_sha256",
    "workflow_run_id",
    "run_attempt"
  ],
  "properties": {
    "schema": {"const": "c5k4-method-v1.5-target-blind-checkpoint-request-1.0"},
    "protocol_version": {"const": "1.5"},
    "scheduled_for_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T00:17:00Z$"},
    "mode": {"enum": ["CAPTURE", "TERMINAL_CHRONOLOGY_GAP"]},
    "public_chain_proof_sha256": {"$ref": "#/definitions/sha256"},
    "public_tip_commit": {"$ref": "#/definitions/oid"},
    "p1r_commit": {"$ref": "#/definitions/oid"},
    "p1r_activation_sha256": {"$ref": "#/definitions/sha256"},
    "workflow_run_id": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
    "run_attempt": {"const": 1}
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}
