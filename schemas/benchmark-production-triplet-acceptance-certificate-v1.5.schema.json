{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Method v1.5 complete production triplet acceptance certificate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "artifact_kind", "protocol_version", "status", "session_nonce_sha256", "host_fingerprint_sha256", "implementation", "tree_count", "accepted_tree_ids", "attestation_set_sha256", "production_triplet_launch_permitted", "activation_permitted", "remaining_blocks", "certificate_sha256"],
  "properties": {
    "schema": {"const": "c5k4-method-v1.5-production-triplet-acceptance-certificate-1.0"},
    "artifact_kind": {"const": "TARGET_FREE_COMPLETE_TRIPLET_ACCEPTANCE_CERTIFICATE"},
    "protocol_version": {"const": "1.5"},
    "status": {"const": "PRE_P1_COMPLETE_ACCEPTANCE_NOT_ACTIVATED"},
    "session_nonce_sha256": {"$ref": "#/definitions/sha256"},
    "host_fingerprint_sha256": {"$ref": "#/definitions/sha256"},
    "implementation": {"type": "object", "additionalProperties": false, "required": ["plan_backend_sha256", "linux_executor_sha256", "adapter_sha256", "fixture_executable_sha256"], "properties": {"plan_backend_sha256": {"$ref": "#/definitions/sha256"}, "linux_executor_sha256": {"$ref": "#/definitions/sha256"}, "adapter_sha256": {"$ref": "#/definitions/sha256"}, "fixture_executable_sha256": {"$ref": "#/definitions/sha256"}}},
    "tree_count": {"const": 24},
    "accepted_tree_ids": {"type": "array", "minItems": 24, "maxItems": 24, "uniqueItems": true, "items": {"type": "string", "pattern": "^(CATALOGUE|GENERIC|WALL_NAVIGATION)-[0-7]$"}},
    "attestation_set_sha256": {"$ref": "#/definitions/sha256"},
    "production_triplet_launch_permitted": {"const": false},
    "activation_permitted": {"const": false},
    "remaining_blocks": {"const": ["TRIPLET_CLI_REMAINS_INERT", "NO_P1_ACTIVATION"]},
    "certificate_sha256": {"$ref": "#/definitions/sha256"}
  },
  "definitions": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
