{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Kuberwastaken/c5-k4/schemas/benchmark-delivery-broker-state-v1.5.schema.json",
  "title": "Method v1.5 PRE-P1 controlled delivery broker durable state",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "status", "sequence_number", "last_receipt_sha256", "last_heartbeat_utc", "active_transaction", "state_sha256"],
  "properties": {
    "schema": {"const": "c5k4-method-v1.5-delivery-broker-state-1.0"},
    "status": {"enum": ["PRE_P1_NOT_OPERATIONAL", "LOCKED_INVALID"]},
    "sequence_number": {"type": "integer", "minimum": -1, "maximum": 9223372036854775807},
    "last_receipt_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/definitions/sha256"}]},
    "last_heartbeat_utc": {"oneOf": [{"type": "null"}, {"$ref": "#/definitions/timestamp"}]},
    "active_transaction": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false,
         "required": ["transaction_id", "phase", "payload_sha256", "payload_byte_count", "delivery_channel"],
         "properties": {
           "transaction_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
           "phase": {"enum": ["PREPARED", "STARTED"]},
           "payload_sha256": {"$ref": "#/definitions/sha256"},
           "payload_byte_count": {"type": "integer", "minimum": 0},
           "delivery_channel": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"}
         }}
      ]
    },
    "state_sha256": {"$ref": "#/definitions/sha256"}
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
