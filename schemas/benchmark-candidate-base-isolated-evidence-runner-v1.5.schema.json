{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Kuberwastaken/c5-k4/schemas/benchmark-candidate-base-isolated-evidence-runner-v1.5.schema.json",
  "title": "Method v1.5 exact-C isolated evidence-runner contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "protocol_version", "operational", "backend", "runtime_image", "daemon", "isolation", "resource_limits", "input_closure", "output_authentication", "activation_blockers"],
  "properties": {
    "schema": {"const": "c5k4-method-v1.5-candidate-base-isolated-evidence-runner-1.0"},
    "status": {"enum": ["FROZEN_POLICY_AWAITING_RUNTIME_AND_SIGNED_DAEMON", "FROZEN_RUNTIME_AWAITING_SIGNED_DAEMON", "EXACT_C_ISOLATED_EVIDENCE_RUNNER_OPERATIONAL"]},
    "protocol_version": {"const": "1.5"},
    "operational": {"type": "boolean"},
    "backend": {"const": {"executable": "/usr/bin/docker", "api_minimum": "1.44", "runtime": "runc", "runtime_minimum": "1.3.5"}},
    "runtime_image": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["reference", "repository_digest", "image_id", "platform", "config_user", "config_env", "config_entrypoint", "config_cmd", "config_working_dir", "verifier_dependency_policy"],
          "properties": {
            "reference": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*(?::[A-Za-z0-9._-]+)?@sha256:[0-9a-f]{64}$"},
            "repository_digest": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*@sha256:[0-9a-f]{64}$"},
            "image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "platform": {"const": "linux/amd64"},
            "config_user": {"type": "null"},
            "config_env": {"const": ["PATH=/usr/local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin", "GPG_KEY=7169605F62C751356D054A26A821E680E5FA6305", "PYTHON_VERSION=3.13.7", "PYTHON_SHA256=5462f9099dfd30e238def83c71d91897d8caa5ff6ebc7a50f14d4802cdaaa79a"]},
            "config_entrypoint": {"type": "null"},
            "config_cmd": {"const": ["python3"]},
            "config_working_dir": {"type": "null"},
            "verifier_dependency_policy": {"const": "PYTHON_3_13_STANDARD_LIBRARY_ONLY"}
          }
        }
      ]
    },
    "daemon": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["host_id", "engine_version", "engine_id", "security_options", "cgroup_version", "cgroup_driver", "default_runtime", "user_namespace_mode", "info_projection_sha256", "attestation"],
          "properties": {
            "host_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "engine_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
            "engine_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "security_options": {"const": ["name=cgroupns", "name=seccomp,profile=builtin", "name=userns"]},
            "cgroup_version": {"const": "2"},
            "cgroup_driver": {"const": "systemd"},
            "default_runtime": {"const": "runc"},
            "user_namespace_mode": {"const": "daemon-userns-remap"},
            "info_projection_sha256": {"$ref": "#/definitions/sha256"},
            "attestation": {
              "type": "object", "additionalProperties": false,
              "required": ["signer_id", "verification_key_base64", "verification_key_sha256", "signature"],
              "properties": {
                "signer_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+-]{0,127}$"},
                "verification_key_base64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$"},
                "verification_key_sha256": {"$ref": "#/definitions/sha256"},
                "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
              }
            }
          }
        }
      ]
    },
    "isolation": {
      "const": {
        "network_mode": "none", "read_only_rootfs": true, "input_mount": "/inputs:ro,rprivate,nosuid,nodev,noexec",
        "repository_mount_permitted": false, "additional_bind_mounts_permitted": false, "cap_drop": ["ALL"],
        "no_new_privileges": true, "seccomp": "builtin", "user": "65534:65534", "private_cgroup_namespace": true,
        "private_ipc_namespace": true, "private_pid_namespace": true, "private_uts_namespace": true,
        "writable_filesystems": ["tmpfs:/tmp:rw,nosuid,nodev,noexec,size=16777216,mode=1777"]
      }
    },
    "resource_limits": {
      "const": {"timeout_seconds": 30, "cpus_nano": 1000000000, "memory_bytes": 536870912, "memory_swap_bytes": 536870912, "pids": 32, "nofile": 64, "fsize_bytes": 1048576, "max_output_bytes": 16384}
    },
    "input_closure": {"const": ["verifier.py", "artifact.schema.json", "artifact.json"]},
    "output_authentication": {"const": "CANONICAL_JSON_BINDS_SHA256_OF_EXACT_C_VERIFIER_AND_EXACT_IMMUTABLE_ARTIFACT_BYTES"},
    "activation_blockers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "allOf": [
    {"if": {"properties": {"operational": {"const": false}}}, "then": {"properties": {"status": {"enum": ["FROZEN_POLICY_AWAITING_RUNTIME_AND_SIGNED_DAEMON", "FROZEN_RUNTIME_AWAITING_SIGNED_DAEMON"]}}}},
    {"if": {"properties": {"status": {"const": "FROZEN_POLICY_AWAITING_RUNTIME_AND_SIGNED_DAEMON"}}}, "then": {"properties": {"operational": {"const": false}, "runtime_image": {"type": "null"}, "daemon": {"type": "null"}, "activation_blockers": {"minItems": 1}}}},
    {"if": {"properties": {"status": {"const": "FROZEN_RUNTIME_AWAITING_SIGNED_DAEMON"}}}, "then": {"properties": {"operational": {"const": false}, "runtime_image": {"type": "object"}, "daemon": {"type": "null"}, "activation_blockers": {"minItems": 1}}}},
    {"if": {"properties": {"operational": {"const": true}}}, "then": {"properties": {"status": {"const": "EXACT_C_ISOLATED_EVIDENCE_RUNNER_OPERATIONAL"}, "runtime_image": {"type": "object"}, "daemon": {"type": "object"}, "activation_blockers": {"maxItems": 0}}}}
  ],
  "definitions": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
