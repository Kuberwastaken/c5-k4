{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Kuberwastaken/c5-k4/schemas/benchmark-registry-input-v1.4.schema.json",
  "title": "Method v1.4 single production registry-build input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority",
    "protocol_version",
    "build_ordinal",
    "allowed_build_count",
    "chronology",
    "upstream",
    "producer",
    "inputs",
    "resolver_receipts",
    "registry_build_invoked_at_utc",
    "controls"
  ],
  "properties": {
    "schema_version": {"const": "c5k4-registry-build-input-1.4"},
    "authority": {"const": "PRODUCTION_AFTER_P0T_S0"},
    "protocol_version": {"const": "1.4"},
    "build_ordinal": {"const": 1},
    "allowed_build_count": {"const": 1},
    "chronology": {"$ref": "#/definitions/chronology"},
    "upstream": {"$ref": "#/definitions/upstream"},
    "producer": {"$ref": "#/definitions/producer"},
    "inputs": {"$ref": "#/definitions/inputs"},
    "resolver_receipts": {"$ref": "#/definitions/resolverReceipts"},
    "registry_build_invoked_at_utc": {"$ref": "#/definitions/timestamp"},
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prototype_inputs_permitted",
        "candidate_semantics_inspected",
        "entropy_used",
        "selected_clusters",
        "selection_or_ranking_permitted",
        "create_exclusive_output_directory",
        "overwrite_permitted"
      ],
      "properties": {
        "prototype_inputs_permitted": {"const": false},
        "candidate_semantics_inspected": {"const": false},
        "entropy_used": {"const": false},
        "selected_clusters": {"type": "array", "maxItems": 0},
        "selection_or_ranking_permitted": {"const": false},
        "create_exclusive_output_directory": {"const": true},
        "overwrite_permitted": {"const": false}
      }
    }
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitOid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256", "canonical_sha256", "schema_version", "authority"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "file_sha256": {"$ref": "#/definitions/sha256"},
        "canonical_sha256": {"$ref": "#/definitions/sha256"},
        "schema_version": {"type": "string", "minLength": 1, "not": {"pattern": "prototype|draft"}},
        "authority": {"enum": ["AUTHORITATIVE_P0", "AUTHORITATIVE_P0T", "AUTHORITATIVE_S0", "FROZEN_PRODUCTION_INPUT"]}
      }
    },
    "chronology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p0_artifact_commit",
        "p0_attestation_commit",
        "p0_published_at_utc",
        "s0_snapshot_id",
        "s0_acquired_at_utc",
        "s0_snapshot_sha256"
      ],
      "properties": {
        "p0_artifact_commit": {"$ref": "#/definitions/gitOid"},
        "p0_attestation_commit": {"$ref": "#/definitions/gitOid"},
        "p0_published_at_utc": {"$ref": "#/definitions/timestamp"},
        "s0_snapshot_id": {"const": "S0"},
        "s0_acquired_at_utc": {"$ref": "#/definitions/timestamp"},
        "s0_snapshot_sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "remote_ref", "commit", "tree", "subtree", "resolution_count", "materialized_repository_path"],
      "properties": {
        "repository": {"const": "https://github.com/google-deepmind/formal-conjectures.git"},
        "remote_ref": {"const": "refs/heads/main"},
        "commit": {"$ref": "#/definitions/gitOid"},
        "tree": {"$ref": "#/definitions/gitOid"},
        "subtree": {"const": "FormalConjectures"},
        "resolution_count": {"const": 1},
        "materialized_repository_path": {"const": "/home/ec2-user/.local/share/c5k4-v14-formal-conjectures.git"}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_id",
        "executable_path",
        "executable_sha256",
        "invocation_contract_sha256",
        "input_schema_sha256",
        "output_schema_sha256"
      ],
      "properties": {
        "producer_id": {"const": "method-v1.4-production-registry-builder"},
        "executable_path": {"const": "scripts/build_benchmark_v14_registry.py"},
        "executable_sha256": {"$ref": "#/definitions/sha256"},
        "invocation_contract_sha256": {"$ref": "#/definitions/sha256"},
        "input_schema_sha256": {"$ref": "#/definitions/sha256"},
        "output_schema_sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p0a",
        "p0t",
        "s0",
        "sources_config",
        "five_strata_classifier",
        "grouping_rule",
        "provenance_policy",
        "source_discovery_boundary",
        "quotas",
        "registry_exemptions"
      ],
      "properties": {
        "p0a": {"$ref": "#/definitions/fileRef"},
        "p0t": {"$ref": "#/definitions/fileRef"},
        "s0": {"$ref": "#/definitions/fileRef"},
        "sources_config": {"$ref": "#/definitions/fileRef"},
        "five_strata_classifier": {"$ref": "#/definitions/fileRef"},
        "grouping_rule": {"$ref": "#/definitions/fileRef"},
        "provenance_policy": {"$ref": "#/definitions/fileRef"},
        "source_discovery_boundary": {"$ref": "#/definitions/fileRef"},
        "quotas": {"$ref": "#/definitions/fileRef"},
        "registry_exemptions": {"$ref": "#/definitions/fileRef"}
      }
    },
    "resolverReceipts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_p0t", "upstream_main"],
      "properties": {
        "public_p0t": {"$ref": "#/definitions/fileRef"},
        "upstream_main": {"$ref": "#/definitions/fileRef"}
      }
    }
  }
}
