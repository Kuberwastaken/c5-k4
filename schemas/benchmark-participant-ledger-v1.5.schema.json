{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Kuberwastaken/c5-k4/schemas/benchmark-participant-ledger-v1.5.schema.json",
  "title": "Method v1.5 PRE-P1 controlled-harness participant and channel ledger",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "status", "protocol_version", "host_id", "phase", "service_identity", "participants", "model_endpoints", "resources", "channels", "network", "excluded_environment", "failure_policy", "claims", "ledger_sha256"],
  "properties": {
    "schema": {"const": "c5k4-method-v1.5-participant-ledger-1.0"},
    "status": {"const": "PRE_P1_PARTICIPANT_SCOPE_NOT_OPERATIONAL"},
    "protocol_version": {"const": "1.5"},
    "host_id": {"const": "ai-vps-controlled-harness"},
    "phase": {"const": "PRE_C1_MACHINE_ONLY"},
    "service_identity": {"const": {"name": "c5k4-benchmark-v15", "kind": "DEDICATED_NONLOGIN_SERVICE_IDENTITY", "provisioned": false, "uid": null, "gid": null}},
    "participants": {"const": ["BROKER_CUSTODY", "FROZEN_GIT_ACQUIRER", "IDENTITY_BUILDER", "GROUP_BUILDER", "STRUCTURAL_CLASSIFIER", "PROVENANCE_CLASSIFIER", "QUOTA_EVALUATOR", "REPLAY_VERIFIER", "CHECKPOINT_RUNNER", "PUBLICATION_VERIFIER"]},
    "model_endpoints": {"const": []},
    "resources": {"const": {
      "p1_checkout": {"path": "/opt/c5k4-benchmark-v15/p1", "owner": "root:root", "mode": "READ_ONLY_TO_SERVICE", "commit": null, "tree": null},
      "private_roots": ["/var/lib/c5k4-benchmark-v15", "/var/cache/c5k4-benchmark-v15"],
      "control_sockets": ["/run/c5k4-benchmark-v15/control.sock"],
      "credential_roots": ["/etc/c5k4-benchmark-v15/credentials"]
    }},
    "channels": {"const": [
      {"channel_id": "CONTROL_TO_BROKER", "payload_class": "CONTROL", "captured_before_delivery": true},
      {"channel_id": "UPSTREAM_TO_GIT_ACQUIRER", "payload_class": "IMMUTABLE_GIT_OBJECTS", "captured_before_delivery": true},
      {"channel_id": "ACQUIRER_TO_IDENTITY_PIPELINE", "payload_class": "IDENTITY_ONLY", "captured_before_delivery": true},
      {"channel_id": "IDENTITY_PIPELINE_TO_CHECKPOINT_RUNNER", "payload_class": "IDENTITY_ONLY", "captured_before_delivery": true},
      {"channel_id": "BROKER_TO_IMMUTABLE_STORE", "payload_class": "SIGNED_EVIDENCE", "captured_before_delivery": true},
      {"channel_id": "CHECKPOINT_RUNNER_TO_PUBLICATION_VERIFIER", "payload_class": "TARGET_BLIND_PUBLICATION", "captured_before_delivery": true}
    ]},
    "network": {"const": {"default": "DENY", "allowed_endpoint_classes": ["UPSTREAM_GIT_HTTPS", "IMMUTABLE_OBJECT_STORE_HTTPS", "KMS_HTTPS", "TRUSTED_TIME_HTTPS", "LOCAL_CONTROL_SOCKET"]}},
    "excluded_environment": {"const": ["COMPANION_MAC", "HUMAN_INTERACTIVE_SESSIONS", "TMUX_SESSIONS", "STOCK_CODEX", "STOCK_CLAUDE", "DOCKER_DAEMON", "LOCAL_LLM_RELAY", "GENERAL_WORKTREES", "GENERAL_VPS_PROCESSES"]},
    "failure_policy": {"const": {"unregistered_ingress": "PROTOCOL_INVALID", "missing_ingress_proof": "PROTOCOL_INVALID", "proved_external_noninterference": "NO_EVIDENCE_UNIT", "manual_exception": "FORBIDDEN", "new_channel_after_p1": "PROTOCOL_INVALID"}},
    "claims": {"const": {"p1_frozen": false, "operational": false, "production_ready": false, "target_specific": false}},
    "ledger_sha256": {"$ref": "#/definitions/sha256"}
  },
  "definitions": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
