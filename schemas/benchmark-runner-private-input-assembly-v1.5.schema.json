{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Kuberwastaken/c5-k4/schemas/benchmark-runner-private-input-assembly-v1.5.schema.json",
  "title": "Method v1.5 private checkpoint-input assembly request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "publication_permitted", "runner_contract", "checkpoint", "p1_scope", "store_acceptance", "artifacts"],
  "properties": {
    "schema": {"const": "c5k4-method-v1.5-runner-private-input-assembly-1.0"},
    "status": {"const": "FROZEN_P1_PRIVATE_INPUT_ASSEMBLY_READY"},
    "publication_permitted": {"const": false},
    "runner_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["runner_path", "invocation_contract_path", "private_input_schema_path", "assembly_executable_sha256"],
      "properties": {
        "runner_path": {"const": "scripts/run_benchmark_v15_checkpoint.py"},
        "invocation_contract_path": {"const": "results/benchmark/v1.5-protocol/checkpoint-invocation-contract.json"},
        "private_input_schema_path": {"const": "schemas/benchmark-checkpoint-runner-private-input-v1.5.schema.json"},
        "assembly_executable_sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["scheduled_for_utc", "public_chain_proof_sha256", "required_custody_from_utc", "required_custody_through_utc"],
      "properties": {
        "scheduled_for_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T00:17:00Z$"},
        "public_chain_proof_sha256": {"$ref": "#/definitions/sha256"},
        "required_custody_from_utc": {"$ref": "#/definitions/timestamp"},
        "required_custody_through_utc": {"$ref": "#/definitions/timestamp"}
      }
    },
    "p1_scope": {
      "type": "object", "additionalProperties": false,
      "required": ["p1t_commit", "p1t_path", "role_resolution_sha256", "participant_ledger_sha256", "participant_ledger_artifact_sha256", "source_boundary_sha256", "noninterference_receipt_sha256", "noninterference_receipt_schema_sha256", "noninterference_verifier_sha256", "operational_noninterference_key_commitment_sha256", "operational_noninterference_key_commitment_schema_sha256", "classifier_readiness_receipt_sha256", "classifier_runtime_binding_schema_sha256", "classifier_runtime_verifier_sha256", "required_host_id"],
      "properties": {
        "p1t_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "p1t_path": {"type": "string", "pattern": "^[^/][^\\u0000]*\\.json$"},
        "role_resolution_sha256": {"$ref": "#/definitions/sha256"},
        "participant_ledger_sha256": {"$ref": "#/definitions/sha256"},
        "participant_ledger_artifact_sha256": {"$ref": "#/definitions/sha256"},
        "source_boundary_sha256": {"$ref": "#/definitions/sha256"},
        "noninterference_receipt_sha256": {"$ref": "#/definitions/sha256"},
        "noninterference_receipt_schema_sha256": {"$ref": "#/definitions/sha256"},
        "noninterference_verifier_sha256": {"$ref": "#/definitions/sha256"},
        "operational_noninterference_key_commitment_sha256": {"$ref": "#/definitions/sha256"},
        "operational_noninterference_key_commitment_schema_sha256": {"$ref": "#/definitions/sha256"},
        "classifier_readiness_receipt_sha256": {"$ref": "#/definitions/sha256"},
        "classifier_runtime_binding_schema_sha256": {"$ref": "#/definitions/sha256"},
        "classifier_runtime_verifier_sha256": {"$ref": "#/definitions/sha256"},
        "required_host_id": {"const": "ai-vps-controlled-harness"}
      }
    },
    "store_acceptance": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "status", "operational", "backend", "config_sha256", "acceptance_receipt_sha256", "retention_through_utc", "private_only", "acceptance_sha256"],
      "properties": {
        "schema": {"const": "c5k4-method-v1.5-worm-store-acceptance-1.0"},
        "status": {"const": "FROZEN_P1_WORM_STORE_ACCEPTED"},
        "operational": {"const": true},
        "backend": {"const": "AWS_S3_OBJECT_LOCK"},
        "config_sha256": {"$ref": "#/definitions/sha256"},
        "acceptance_receipt_sha256": {"$ref": "#/definitions/sha256"},
        "retention_through_utc": {"$ref": "#/definitions/timestamp"},
        "private_only": {"const": true},
        "acceptance_sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "artifacts": {
      "type": "object", "additionalProperties": false,
      "required": [
        "u1_receipt", "checkpoint_capture", "v14_exclusion", "grouping_rule",
        "classifier", "public_chain_proof", "provenance_content_pack",
        "provenance_ledgers", "custody_coverage_certificate",
        "public_custody_sealed_binding", "sealed_private_custody_bundle",
        "p1_role_resolution", "participant_ledger", "source_boundary", "noninterference_receipt", "noninterference_receipt_schema", "noninterference_verifier", "operational_noninterference_key_commitment", "operational_noninterference_key_commitment_schema", "noninterference_verification_key", "classifier_readiness_receipt", "service_epoch_binding",
        "primary_acquisition_receipt", "replay_acquisition_receipt",
        "primary_private_registry", "replayed_private_registry"
      ],
      "properties": {
        "u1_receipt": {"$ref": "#/definitions/locator"},
        "checkpoint_capture": {"$ref": "#/definitions/locator"},
        "v14_exclusion": {"$ref": "#/definitions/locator"},
        "grouping_rule": {"$ref": "#/definitions/locator"},
        "classifier": {"$ref": "#/definitions/locator"},
        "public_chain_proof": {"$ref": "#/definitions/locator"},
        "provenance_content_pack": {"$ref": "#/definitions/locator"},
        "provenance_ledgers": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/definitions/locator"}},
        "custody_coverage_certificate": {"$ref": "#/definitions/locator"},
        "public_custody_sealed_binding": {"$ref": "#/definitions/locator"},
        "sealed_private_custody_bundle": {"$ref": "#/definitions/locator"},
        "p1_role_resolution": {"$ref": "#/definitions/locator"},
        "participant_ledger": {"$ref": "#/definitions/locator"},
        "source_boundary": {"$ref": "#/definitions/locator"},
        "noninterference_receipt": {"$ref": "#/definitions/locator"},
        "noninterference_receipt_schema": {"$ref": "#/definitions/locator"},
        "noninterference_verifier": {"$ref": "#/definitions/locator"},
        "operational_noninterference_key_commitment": {"$ref": "#/definitions/locator"},
        "operational_noninterference_key_commitment_schema": {"$ref": "#/definitions/locator"},
        "noninterference_verification_key": {"$ref": "#/definitions/locator"},
        "classifier_readiness_receipt": {"$ref": "#/definitions/locator"},
        "service_epoch_binding": {"$ref": "#/definitions/locator"},
        "primary_acquisition_receipt": {"$ref": "#/definitions/locator"},
        "replay_acquisition_receipt": {"$ref": "#/definitions/locator"},
        "primary_private_registry": {"$ref": "#/definitions/locator"},
        "replayed_private_registry": {"$ref": "#/definitions/locator"}
      }
    }
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "locator": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "status", "backend", "bucket", "key", "version_id", "sha256", "byte_count", "retain_until_utc", "store_acceptance_sha256", "private_only"],
      "properties": {
        "schema": {"const": "c5k4-method-v1.5-private-artifact-locator-1.0"},
        "status": {"const": "FROZEN_P1_WORM_OBJECT_VERIFIED"},
        "backend": {"const": "AWS_S3_OBJECT_LOCK"},
        "bucket": {"type": "string", "minLength": 3, "maxLength": 63, "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"},
        "key": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000]+$"},
        "version_id": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000]+$"},
        "sha256": {"$ref": "#/definitions/sha256"},
        "byte_count": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "retain_until_utc": {"$ref": "#/definitions/timestamp"},
        "store_acceptance_sha256": {"$ref": "#/definitions/sha256"},
        "private_only": {"const": true}
      }
    }
  }
}
