{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Kuberwastaken/c5-k4/schemas/benchmark-public-readiness-authority-root-v1.5.schema.json",
  "title": "Method v1.5 public pre-C readiness authority root",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "protocol_version", "authority_epoch_id", "created_at_utc", "target_specific", "controlled_harness", "experimenters", "evidence_issuers", "independent_recompilers", "nonintervention_contract_sha256", "challenge_namespace_sha256", "authority_root_sha256"],
  "properties": {
    "schema": {"const": "c5k4-method-v1.5-public-readiness-authority-root-1.0"},
    "status": {"const": "PUBLIC_PRE_C_READINESS_AUTHORITIES_FROZEN"},
    "protocol_version": {"const": "1.5"},
    "authority_epoch_id": {"$ref": "#/definitions/id"},
    "created_at_utc": {"$ref": "#/definitions/time"},
    "target_specific": {"const": false},
    "controlled_harness": {"$ref": "#/definitions/harness"},
    "experimenters": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/experimenter"}},
    "evidence_issuers": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/definitions/evidenceIssuer"}},
    "independent_recompilers": {"type": "array", "minItems": 2, "items": {"$ref": "#/definitions/recompiler"}},
    "nonintervention_contract_sha256": {"$ref": "#/definitions/sha256"},
    "challenge_namespace_sha256": {"$ref": "#/definitions/sha256"},
    "authority_root_sha256": {"$ref": "#/definitions/sha256"}
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+-]{0,127}$"},
    "time": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "baseSigner": {
      "type": "object", "additionalProperties": false,
      "required": ["signer_class", "signer_id", "verification_key_sha256"],
      "properties": {
        "signer_class": {"type": "string"}, "signer_id": {"$ref": "#/definitions/id"},
        "verification_key_sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "harness": {"allOf": [{"$ref": "#/definitions/baseSigner"}, {"properties": {"signer_class": {"const": "CONTROLLED_HARNESS_READINESS_KEY"}}}]},
    "experimenter": {"allOf": [{"$ref": "#/definitions/baseSigner"}, {"properties": {"signer_class": {"const": "FROZEN_EXPERIMENTER_IDENTITY"}}}]},
    "recompiler": {"allOf": [{"$ref": "#/definitions/baseSigner"}, {"properties": {"signer_class": {"const": "INDEPENDENT_RECOMPILER"}}}]},
    "evidenceIssuer": {
      "type": "object", "additionalProperties": false,
      "required": ["signer_class", "domain", "signer_id", "verification_key_sha256"],
      "properties": {
        "signer_class": {"const": "OPERATIONAL_EVIDENCE_ISSUER"},
        "domain": {"enum": ["PARTICIPANT_SCOPE_AND_NONINTERFERENCE", "CONTROLLED_HARNESS_DEPLOYMENT_AND_RUNTIME", "IMMUTABLE_WORM_STORE", "DESTRUCTIVE_GAP_ACCEPTANCE", "BROKER_CUSTODY_AND_CAPTURE_REPLAY", "CLASSIFIER_CLOSURE", "EXPERIMENTER_NONINTERVENTION"]},
        "signer_id": {"$ref": "#/definitions/id"}, "verification_key_sha256": {"$ref": "#/definitions/sha256"}
      }
    }
  }
}
