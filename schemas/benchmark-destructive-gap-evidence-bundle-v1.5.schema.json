{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Kuberwastaken/c5-k4/schemas/benchmark-destructive-gap-evidence-bundle-v1.5.schema.json",
  "title": "Method v1.5 signed target-blind destructive-gap evidence bundle",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "status", "protocol_version", "host_id", "committed_plan_sha256", "service_epoch_binding_sha256", "key_commitment", "evidence", "target_specific", "bundle_sha256"],
  "properties": {
    "schema": {"const": "c5k4-method-v1.5-destructive-gap-evidence-bundle-1.0"},
    "status": {"enum": ["LIVE_CONTROLLED_HARNESS_EVIDENCE", "FIXTURE_EVIDENCE_NONOPERATIONAL"]},
    "protocol_version": {"const": "1.5"}, "host_id": {"const": "ai-vps-controlled-harness"},
    "committed_plan_sha256": {"$ref": "#/definitions/sha256"},
    "service_epoch_binding_sha256": {"$ref": "#/definitions/sha256"},
    "key_commitment": {"$ref": "#/definitions/keyCommitment"},
    "evidence": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": [
        {"allOf": [{"$ref": "#/definitions/evidence"}, {"properties": {"test": {"const": "DESTRUCTIVE_WRITE"}}}]},
        {"allOf": [{"$ref": "#/definitions/evidence"}, {"properties": {"test": {"const": "TRUNCATION"}}}]},
        {"allOf": [{"$ref": "#/definitions/evidence"}, {"properties": {"test": {"const": "SERVICE_RESTART"}}}]},
        {"allOf": [{"$ref": "#/definitions/evidence"}, {"properties": {"test": {"const": "OFFLINE_GAP"}}}]},
        {"allOf": [{"$ref": "#/definitions/evidence"}, {"properties": {"test": {"const": "SEQUENCE_CONFLICT"}}}]},
        {"allOf": [{"$ref": "#/definitions/evidence"}, {"properties": {"test": {"const": "UNEXPECTED_INGRESS"}}}]}
      ],
      "additionalItems": false
    },
    "target_specific": {"const": false}, "bundle_sha256": {"$ref": "#/definitions/sha256"}
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"},
    "keyCommitment": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "status", "protocol_version", "host_id", "signing_key_id", "signature_algorithm", "verification_key_sha256", "operational", "activation_permitted", "target_specific", "commitment_sha256"],
      "properties": {
        "schema": {"const": "c5k4-method-v1.5-operational-noninterference-key-commitment-1.0"},
        "status": {"const": "FROZEN_P1_NONINTERFERENCE_KEY_COMMITTED"}, "protocol_version": {"const": "1.5"},
        "host_id": {"const": "ai-vps-controlled-harness"}, "signing_key_id": {"$ref": "#/definitions/id"},
        "signature_algorithm": {"const": "Ed25519"}, "verification_key_sha256": {"$ref": "#/definitions/sha256"},
        "operational": {"const": true}, "activation_permitted": {"const": true}, "target_specific": {"const": false},
        "commitment_sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "execution_context", "test", "request_sha256", "result_sha256", "pre_state_sha256", "post_state_sha256", "committed_plan_sha256", "service_epoch_binding_sha256", "signing_key_id", "verification_key_sha256", "signature_algorithm", "observed_at_utc", "passed", "evidence_sha256", "signature"],
      "properties": {
        "schema": {"const": "c5k4-method-v1.5-destructive-gap-evidence-1.0"},
        "execution_context": {"enum": ["LIVE_CONTROLLED_HARNESS", "FIXTURE_NONOPERATIONAL"]},
        "test": {"enum": ["DESTRUCTIVE_WRITE", "TRUNCATION", "SERVICE_RESTART", "OFFLINE_GAP", "SEQUENCE_CONFLICT", "UNEXPECTED_INGRESS"]},
        "request_sha256": {"$ref": "#/definitions/sha256"}, "result_sha256": {"$ref": "#/definitions/sha256"},
        "pre_state_sha256": {"$ref": "#/definitions/sha256"}, "post_state_sha256": {"$ref": "#/definitions/sha256"},
        "committed_plan_sha256": {"$ref": "#/definitions/sha256"}, "service_epoch_binding_sha256": {"$ref": "#/definitions/sha256"},
        "signing_key_id": {"$ref": "#/definitions/id"}, "verification_key_sha256": {"$ref": "#/definitions/sha256"},
        "signature_algorithm": {"const": "Ed25519"},
        "observed_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "passed": {"type": "boolean"}, "evidence_sha256": {"$ref": "#/definitions/sha256"}, "signature": {"$ref": "#/definitions/signature"}
      }
    }
  }
}
