{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Kuberwastaken/c5-k4/schemas/benchmark-v1.3-c0.schema.json",
  "title": "Method v1.3 non-circular C0 artifact and attestation",
  "oneOf": [
    {"$ref": "#/definitions/c0a"},
    {"$ref": "#/definitions/c0t"}
  ],
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitOid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "nullableGitOid": {"oneOf": [{"$ref": "#/definitions/gitOid"}, {"type": "null"}]},
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "nullableTimestamp": {"oneOf": [{"$ref": "#/definitions/timestamp"}, {"type": "null"}]},
    "fileDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "randomness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "chain_hash", "round", "round_closes_at_utc", "value"],
      "properties": {
        "source": {"const": "League of Entropy drand"},
        "chain_hash": {"const": "8990e7a9aaed2ffed73dbd7092123d6f289930540d7651336225dc172e51b2ce"},
        "round": {"type": "integer", "minimum": 1},
        "round_closes_at_utc": {"$ref": "#/definitions/timestamp"},
        "value": {"type": "null"}
      }
    },
    "chronologyA": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p0_artifact_commit", "p0_attestation_commit", "p0_published_at_utc",
        "s0_acquired_at_utc", "feasibility_checked_at_utc",
        "c0_artifact_commit", "c0_attestation_commit", "c0_published_at_utc"
      ],
      "properties": {
        "p0_artifact_commit": {"$ref": "#/definitions/gitOid"},
        "p0_attestation_commit": {"$ref": "#/definitions/gitOid"},
        "p0_published_at_utc": {"$ref": "#/definitions/timestamp"},
        "s0_acquired_at_utc": {"$ref": "#/definitions/timestamp"},
        "feasibility_checked_at_utc": {"$ref": "#/definitions/timestamp"},
        "c0_artifact_commit": {"type": "null"},
        "c0_attestation_commit": {"type": "null"},
        "c0_published_at_utc": {"type": "null"}
      }
    },
    "chronologyT": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p0_artifact_commit", "p0_attestation_commit", "p0_published_at_utc",
        "s0_acquired_at_utc", "c0_artifact_commit", "c0_attestation_commit",
        "c0_published_at_utc"
      ],
      "properties": {
        "p0_artifact_commit": {"$ref": "#/definitions/gitOid"},
        "p0_attestation_commit": {"$ref": "#/definitions/gitOid"},
        "p0_published_at_utc": {"$ref": "#/definitions/timestamp"},
        "s0_acquired_at_utc": {"$ref": "#/definitions/timestamp"},
        "c0_artifact_commit": {"$ref": "#/definitions/gitOid"},
        "c0_attestation_commit": {"type": "null"},
        "c0_published_at_utc": {"$ref": "#/definitions/timestamp"}
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible_pool", "quota_feasibility", "selector_artifacts", "protocol_components", "selection_algorithm"],
      "properties": {
        "eligible_pool": {"$ref": "#/definitions/fileDigest"},
        "quota_feasibility": {"$ref": "#/definitions/fileDigest"},
        "selector_artifacts": {
          "type": "object",
          "additionalProperties": {"$ref": "#/definitions/fileDigest"}
        },
        "protocol_components": {
          "type": "object",
          "additionalProperties": {"$ref": "#/definitions/fileDigest"}
        },
        "selection_algorithm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "schema_version", "domain_hex", "selector_sha256"],
          "properties": {
            "name": {"const": "UNBIASED_DOMAIN_SEPARATED_SHA256_FISHER_YATES"},
            "schema_version": {"const": "c5k4-benchmark-selection-1.3"},
            "domain_hex": {"type": "string", "pattern": "^[0-9a-f]+$"},
            "selector_sha256": {"$ref": "#/definitions/sha256"}
          }
        }
      }
    },
    "c0a": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "artifact_kind", "protocol_version", "phase",
        "p0a", "p0t", "s0", "bindings", "upstream", "pool_file_sha256",
        "quota_feasibility_sha256", "randomness", "chronology", "published_at_utc",
        "entropy_used", "selected_clusters", "target_ranking"
      ],
      "properties": {
        "schema_version": {"const": "c5k4-method-v1.3-c0-1.0"},
        "artifact_kind": {"const": "C0A"},
        "protocol_version": {"const": "1.3"},
        "phase": {"const": "C0_ARTIFACT"},
        "p0a": {"$ref": "#/definitions/fileDigest"},
        "p0t": {"$ref": "#/definitions/fileDigest"},
        "s0": {"$ref": "#/definitions/fileDigest"},
        "bindings": {"$ref": "#/definitions/bindings"},
        "upstream": {"type": "object"},
        "pool_file_sha256": {"$ref": "#/definitions/sha256"},
        "quota_feasibility_sha256": {"$ref": "#/definitions/sha256"},
        "randomness": {"$ref": "#/definitions/randomness"},
        "chronology": {"$ref": "#/definitions/chronologyA"},
        "published_at_utc": {"type": "null"},
        "entropy_used": {"const": false},
        "selected_clusters": {"type": "array", "maxItems": 0},
        "target_ranking": {"type": "array", "maxItems": 0}
      }
    },
    "c0t": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "artifact_kind", "protocol_version", "phase", "c0a",
        "pool_file_sha256", "quota_feasibility_sha256", "bindings_sha256",
        "randomness", "chronology", "published_at_utc", "publication_observation",
        "entropy_used", "selected_clusters", "target_ranking", "attestation_policy"
      ],
      "properties": {
        "schema_version": {"const": "c5k4-c0-randomness-contract-1.3"},
        "artifact_kind": {"const": "C0T"},
        "protocol_version": {"const": "1.3"},
        "phase": {"const": "C0_FROZEN"},
        "c0a": {"$ref": "#/definitions/fileDigest"},
        "pool_file_sha256": {"$ref": "#/definitions/sha256"},
        "quota_feasibility_sha256": {"$ref": "#/definitions/sha256"},
        "bindings_sha256": {"$ref": "#/definitions/sha256"},
        "randomness": {"$ref": "#/definitions/randomness"},
        "chronology": {"$ref": "#/definitions/chronologyT"},
        "published_at_utc": {"$ref": "#/definitions/timestamp"},
        "publication_observation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "repository", "observed_commit", "observed_at_utc"],
          "properties": {
            "source": {"const": "GITHUB_COMMIT_API_OBSERVATION"},
            "repository": {"const": "https://github.com/Kuberwastaken/c5-k4"},
            "observed_commit": {"$ref": "#/definitions/gitOid"},
            "observed_at_utc": {"$ref": "#/definitions/timestamp"}
          }
        },
        "entropy_used": {"const": false},
        "selected_clusters": {"type": "array", "maxItems": 0},
        "target_ranking": {"type": "array", "maxItems": 0},
        "attestation_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["direct_parent_required", "nonmerge_required", "c0a_bytes_immutable", "allowed_c0t_changed_paths"],
          "properties": {
            "direct_parent_required": {"const": true},
            "nonmerge_required": {"const": true},
            "c0a_bytes_immutable": {"const": true},
            "allowed_c0t_changed_paths": {
              "type": "array", "minItems": 1, "maxItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
