{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Kuberwastaken/c5-k4/schemas/benchmark-s3-object-lock-store-config-v1.5.schema.json",
  "title": "Method v1.5 PRE-P1 S3 Object Lock store adapter configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "backend", "bucket", "expected_bucket_owner", "region",
    "key_prefix", "kms_key_arn", "bucket_policy_sha256", "benchmark_horizon_utc", "retention_through_utc",
    "required_object_lock_mode", "put_if_absent", "private_only"
  ],
  "properties": {
    "schema": {"const": "c5k4-method-v1.5-s3-object-lock-store-config-1.0"},
    "status": {"const": "PRE_P1_STORE_ADAPTER_NOT_OPERATIONAL"},
    "backend": {"const": "AWS_S3_OBJECT_LOCK"},
    "bucket": {"type": "string", "minLength": 3, "maxLength": 63, "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"},
    "expected_bucket_owner": {"type": "string", "pattern": "^[0-9]{12}$"},
    "region": {"type": "string", "pattern": "^[a-z]{2}(-gov)?-[a-z]+-[0-9]+$"},
    "key_prefix": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*[A-Za-z0-9]$"},
    "kms_key_arn": {"type": "string", "pattern": "^arn:aws:kms:[a-z]{2}(-gov)?-[a-z]+-[0-9]+:[0-9]{12}:key/[0-9a-f-]{36}$"},
    "bucket_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "benchmark_horizon_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "retention_through_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "required_object_lock_mode": {"const": "COMPLIANCE"},
    "put_if_absent": {"const": true},
    "private_only": {"const": true}
  }
}
