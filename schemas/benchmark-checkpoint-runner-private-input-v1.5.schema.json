{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Kuberwastaken/c5-k4/schemas/benchmark-checkpoint-runner-private-input-v1.5.schema.json",
  "title": "Method v1.5 private checkpoint-runner input contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "runner_contract", "checkpoint", "custody", "registry", "replay"],
  "properties": {
    "schema": {"const": "c5k4-method-v1.5-checkpoint-runner-private-input-1.0"},
    "status": {"const": "PRIVATE_CUSTODY_READY"},
    "runner_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "runner_path", "invocation_contract_path", "private_input_argument"],
      "properties": {
        "mode": {"const": "CAPTURE"},
        "runner_path": {"const": "scripts/run_benchmark_v15_checkpoint.py"},
        "invocation_contract_path": {"const": "results/benchmark/v1.5-protocol/checkpoint-invocation-contract.json"},
        "private_input_argument": {"const": "--private-input"}
      }
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["scheduled_for_utc", "public_chain_proof_sha256"],
      "properties": {
        "scheduled_for_utc": {"$ref": "#/definitions/tick"},
        "public_chain_proof_sha256": {"$ref": "#/definitions/sha"}
      }
    },
    "custody": {
      "type": "object", "additionalProperties": false,
      "required": ["coverage_certificate", "public_sealed_binding", "participant_ledger_sha256", "source_boundary_sha256", "noninterference_receipt_sha256", "host_id", "signing_key_id", "service_epoch_binding_sha256", "store_acceptance_sha256"],
      "properties": {
        "coverage_certificate": {"$ref": "#/definitions/privateFile"},
        "public_sealed_binding": {"$ref": "#/definitions/privateFile"},
        "participant_ledger_sha256": {"$ref": "#/definitions/sha"},
        "source_boundary_sha256": {"$ref": "#/definitions/sha"},
        "noninterference_receipt_sha256": {"$ref": "#/definitions/sha"},
        "host_id": {"const": "ai-vps-controlled-harness"},
        "signing_key_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "service_epoch_binding_sha256": {"$ref": "#/definitions/sha"},
        "store_acceptance_sha256": {"$ref": "#/definitions/sha"}
      }
    },
    "registry": {
      "type": "object", "additionalProperties": false,
      "required": ["private_registry", "provenance_content_pack", "provenance_ledgers"],
      "properties": {
        "private_registry": {"$ref": "#/definitions/privateFile"},
        "provenance_content_pack": {"$ref": "#/definitions/privateFile"},
        "provenance_ledgers": {
          "type": "array", "minItems": 1, "maxItems": 4096,
          "items": {"$ref": "#/definitions/privateFile"}
        }
      }
    },
    "replay": {
      "type": "object", "additionalProperties": false,
      "required": ["isolated_repository", "fresh_reacquisition_completed", "network_acquisition_by_runner"],
      "properties": {
        "isolated_repository": {"type": "string", "minLength": 1, "pattern": "^/[^\\u0000]*$"},
        "fresh_reacquisition_completed": {"const": true},
        "network_acquisition_by_runner": {"const": false}
      }
    }
  },
  "definitions": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tick": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T00:17:00Z$"},
    "privateFile": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^/[^\\u0000]*$"},
        "sha256": {"$ref": "#/definitions/sha"}
      }
    }
  }
}
