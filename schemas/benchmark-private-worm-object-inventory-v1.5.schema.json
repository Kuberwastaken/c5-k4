{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Kuberwastaken/c5-k4/schemas/benchmark-private-worm-object-inventory-v1.5.schema.json",
  "title": "Method v1.5 PRE-P1 private WORM object inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "protocol_version", "visibility", "backend",
    "store_config_sha256", "bucket", "required_object_lock_mode",
    "private_only", "retain_through_utc", "objects", "inventory_sha256"
  ],
  "properties": {
    "schema": {"const": "c5k4-method-v1.5-private-worm-object-inventory-1.0"},
    "status": {"const": "PRE_P1_PRIVATE_CUSTODY_NOT_OPERATIONAL"},
    "protocol_version": {"const": "1.5"},
    "visibility": {"const": "PRIVATE_TARGET_BEARING"},
    "backend": {"const": "AWS_S3_OBJECT_LOCK_VERSION_PINNED"},
    "store_config_sha256": {"$ref": "#/definitions/sha256"},
    "bucket": {"type": "string", "minLength": 3, "maxLength": 63, "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"},
    "required_object_lock_mode": {"const": "COMPLIANCE"},
    "private_only": {"const": true},
    "retain_through_utc": {"$ref": "#/definitions/timestamp"},
    "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200001,
      "items": {"$ref": "#/definitions/objectReference"}
    },
    "inventory_sha256": {"$ref": "#/definitions/sha256"}
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "sequence": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "objectReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role", "broker_sequence_number", "bucket", "key", "version_id",
        "sha256", "byte_count", "retain_until_utc", "object_lock_mode"
      ],
      "properties": {
        "role": {"enum": ["BROKER_RECEIPT", "DELIVERY_PAYLOAD", "SERVICE_EPOCH_BINDING"]},
        "broker_sequence_number": {"oneOf": [{"type": "null"}, {"$ref": "#/definitions/sequence"}]},
        "bucket": {"type": "string", "minLength": 3, "maxLength": 63, "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"},
        "key": {"type": "string", "minLength": 1, "maxLength": 1024},
        "version_id": {"type": "string", "minLength": 1, "maxLength": 1024},
        "sha256": {"$ref": "#/definitions/sha256"},
        "byte_count": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "retain_until_utc": {"$ref": "#/definitions/timestamp"},
        "object_lock_mode": {"const": "COMPLIANCE"}
      },
      "allOf": [
        {
          "if": {"properties": {"role": {"const": "BROKER_RECEIPT"}}},
          "then": {"properties": {"broker_sequence_number": {"$ref": "#/definitions/sequence"}}},
          "else": {"properties": {"broker_sequence_number": {"type": "null"}}}
        }
      ]
    }
  }
}
