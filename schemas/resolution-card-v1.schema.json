{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Kuberwastaken/c5-k4/schemas/resolution-card-v1.schema.json",
  "title": "c5-k4 Method v1 resolution card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "resolution_card",
    "status_coordinates",
    "trial",
    "ledger"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schema_version": {"const": "c5k4-resolution-card-1.0"},
    "contract": {"$ref": "#/definitions/fileDigest"},
    "resolution_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_class",
        "target_negation",
        "finite_witness_suffices",
        "negation_certificate",
        "exact_residual"
      ],
      "properties": {
        "logical_class": {
          "enum": [
            "FINITE_UNIVERSAL",
            "ASYMPTOTIC_UNIFORM",
            "EXISTENTIAL",
            "FIXED_OPTIMUM_OR_ANSWER"
          ]
        },
        "target_negation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["literal", "derivation", "declaration_blob_sha256"],
          "properties": {
            "literal": {"type": "string", "minLength": 1},
            "derivation": {"type": "string", "minLength": 1},
            "declaration_blob_sha256": {"$ref": "#/definitions/sha256"}
          }
        },
        "finite_witness_suffices": {"type": "boolean"},
        "negation_certificate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "description", "replay"],
          "properties": {
            "kind": {
              "enum": [
                "FINITE_OBJECT_EXACT_CHECK",
                "INFINITE_FAMILY_SYMBOLIC_RATE",
                "POSITIVE_CONSTRUCTION",
                "GLOBAL_NONEXISTENCE",
                "GLOBAL_LOWER_AND_UPPER"
              ]
            },
            "description": {"type": "string", "minLength": 1},
            "replay": {"type": "string", "minLength": 1}
          }
        },
        "exact_residual": {"$ref": "#/definitions/exactResidual"}
      }
    },
    "status_coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "informal_status",
        "formal_solution_status",
        "statement_formalized",
        "declaration_status"
      ],
      "properties": {
        "informal_status": {"$ref": "#/definitions/statusCoordinate"},
        "formal_solution_status": {"$ref": "#/definitions/statusCoordinate"},
        "statement_formalized": {"$ref": "#/definitions/statusCoordinate"},
        "declaration_status": {"$ref": "#/definitions/statusCoordinate"}
      }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane",
        "authorization",
        "evidence_split",
        "process_wall_cap_seconds",
        "carrier_identity",
        "theorem_baselines",
        "sign_potential"
      ],
      "properties": {
        "lane": {
          "enum": [
            "COUNTEREXAMPLE",
            "SYMBOLIC_PROOF",
            "CONSTRUCTION",
            "FIXED_VALUE",
            "STATUS_ONLY"
          ]
        },
        "authorization": {"enum": ["RUN", "STOP_ONLY"]},
        "evidence_split": {"$ref": "#/definitions/evidenceSplit"},
        "process_wall_cap_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60
        },
        "solver_cap_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60
        },
        "preregistered_commit": {"$ref": "#/definitions/gitCommit"},
        "carrier_identity": {"$ref": "#/definitions/carrierIdentity"},
        "theorem_baselines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["baseline_id", "statement"],
            "properties": {
              "baseline_id": {"type": "string", "minLength": 1},
              "statement": {"type": "string", "minLength": 1}
            }
          }
        },
        "sign_potential": {
          "type": "array",
          "items": {"$ref": "#/definitions/signPotentialRow"}
        }
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "evidence_split", "append_only", "prerequisites"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "evidence_split": {"$ref": "#/definitions/evidenceSplit"},
        "append_only": {"const": true},
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "evidence_split"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"$ref": "#/definitions/sha256"},
              "evidence_split": {"$ref": "#/definitions/evidenceSplit"}
            }
          }
        }
      }
    }
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40,64}$"
    },
    "evidenceSplit": {
      "enum": ["CALIBRATION", "DEVELOPMENT", "HELDOUT"]
    },
    "fileDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "statusCoordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "revision",
        "scope",
        "raw_value",
        "captured_at_utc",
        "evidence"
      ],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "raw_value": {"type": "string", "minLength": 1},
        "captured_at_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
        },
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "exactResidual": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "expression",
            "convention",
            "crossing_condition"
          ],
          "properties": {
            "available": {"const": true},
            "expression": {"type": "string", "minLength": 1},
            "convention": {
              "enum": [
                "HOLDS_NONNEGATIVE",
                "HOLDS_NONPOSITIVE",
                "BOOLEAN_EXACT",
                "OPTIMUM_GAP"
              ]
            },
            "crossing_condition": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["available", "reason"],
          "properties": {
            "available": {"const": false},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "carrierIdentity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sha256", "canonicalization"],
          "properties": {
            "kind": {
              "enum": [
                "LABELLED_OBJECT_WITH_ROLES",
                "UNLABELLED_OBJECT",
                "FAMILY_CONSTRUCTOR_AND_GRID"
              ]
            },
            "sha256": {"$ref": "#/definitions/sha256"},
            "canonicalization": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reason"],
          "properties": {
            "kind": {"const": "NOT_APPLICABLE"},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "signPotentialRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "term_id",
        "role",
        "exact_expression",
        "predicted_delta",
        "effect_on_target_residual",
        "rationale"
      ],
      "properties": {
        "term_id": {"type": "string", "minLength": 1},
        "role": {
          "enum": [
            "PREMISE_MARGIN",
            "TARGET_RESIDUAL",
            "THEOREM_BASELINE",
            "CERTIFICATE_COST",
            "RESIDUAL_TERM"
          ]
        },
        "exact_expression": {"type": "string", "minLength": 1},
        "predicted_delta": {
          "enum": ["INCREASE", "DECREASE", "PINNED", "UNKNOWN"]
        },
        "effect_on_target_residual": {
          "enum": ["INCREASE", "DECREASE", "PINNED", "UNKNOWN"]
        },
        "rationale": {"type": "string", "minLength": 1}
      }
    }
  }
}
