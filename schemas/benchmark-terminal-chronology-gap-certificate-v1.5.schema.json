{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Kuberwastaken/c5-k4/schemas/benchmark-terminal-chronology-gap-certificate-v1.5.schema.json",
  "title": "Method v1.5 terminal chronology-gap certificate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "artifact_kind", "protocol_version", "scheduled_for_utc", "status", "public_chain_proof_sha256", "capture_attempted", "private_inputs_read", "certificate_sha256"],
  "properties": {
    "schema": {"const": "c5k4-method-v1.5-terminal-chronology-gap-certificate-1.0"},
    "artifact_kind": {"const": "TERMINAL_CHRONOLOGY_GAP_CERTIFICATE"},
    "protocol_version": {"const": "1.5"},
    "scheduled_for_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T00:17:00Z$"},
    "status": {"const": "INVALID_CHRONOLOGY_CAPTURE"},
    "public_chain_proof_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capture_attempted": {"const": false},
    "private_inputs_read": {"const": false},
    "certificate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
