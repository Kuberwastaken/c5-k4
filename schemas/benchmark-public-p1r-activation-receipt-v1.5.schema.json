{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Kuberwastaken/c5-k4/schemas/benchmark-public-p1r-activation-receipt-v1.5.schema.json",
  "title": "Method v1.5 full exact-C public P1R activation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "p1r", "p1r_commit", "activation_boundary", "public_observation", "validation_inputs_sha256", "validation_diagnostic_sha256", "validator", "receipt_sha256"],
  "properties": {
    "schema": {"const": "c5k4-method-v1.5-public-p1r-activation-receipt-1.0"},
    "p1r": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "results/benchmark/v1.5-protocol/P1R.json"},
        "sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "p1r_commit": {"$ref": "#/definitions/gitOid"},
    "activation_boundary": {"const": "PUBLIC_AUTHENTICATED_P1R"},
    "public_observation": {
      "type": "object", "additionalProperties": false,
      "required": ["workflow_repository", "workflow_path", "workflow_blob_sha256", "workflow_ref", "run_id", "run_attempt", "server_observed_at_utc", "actions_run_projection_sha256"],
      "properties": {
        "workflow_repository": {"const": "Kuberwastaken/c5-k4"},
        "workflow_path": {"const": ".github/workflows/method-v15-p1r-publication-observer.yml"},
        "workflow_blob_sha256": {"$ref": "#/definitions/sha256"},
        "workflow_ref": {"const": ".github/workflows/method-v15-p1r-publication-observer.yml@refs/heads/method-v1.5-p1r"},
        "run_id": {"type": "integer", "minimum": 1},
        "run_attempt": {"const": 1},
        "server_observed_at_utc": {"$ref": "#/definitions/time"},
        "actions_run_projection_sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "validation_inputs_sha256": {"$ref": "#/definitions/sha256"},
    "validation_diagnostic_sha256": {"$ref": "#/definitions/sha256"},
    "validator": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "scripts/validate_benchmark_v15_candidate_base.py"},
        "sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "receipt_sha256": {"$ref": "#/definitions/sha256"}
  },
  "definitions": {
    "gitOid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "time": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"}
  }
}
