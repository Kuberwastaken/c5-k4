{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Kuberwastaken/c5-k4/schemas/benchmark-p1r-v1.5.schema.json",
  "title": "Method v1.5 nonauthoritative structural post-P1T observation draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_kind", "status", "protocol_version", "p1t", "p1t_commit", "observation", "activation_policy"],
  "properties": {
    "schema_version": {"const": "c5k4-method-v1.5-p1r-1.0"},
    "artifact_kind": {"const": "P1R"},
    "status": {"const": "NONAUTHORITATIVE_DRAFT_AWAITING_FULL_EXACT_C_REPLAY"},
    "protocol_version": {"const": "1.5"},
    "p1t": {"$ref": "#/definitions/fileDigest"},
    "p1t_commit": {"$ref": "#/definitions/gitOid"},
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["public_remote_url", "authority_root", "v1_4_p0t", "candidate_c", "p1t", "observed_at_utc", "ls_remote_stdout_sha256", "observer"],
      "properties": {
        "public_remote_url": {"const": "https://github.com/Kuberwastaken/c5-k4"},
        "authority_root": {"$ref": "#/definitions/publicBinding"}, "v1_4_p0t": {"$ref": "#/definitions/publicBinding"},
        "candidate_c": {"$ref": "#/definitions/publicBinding"}, "p1t": {"$ref": "#/definitions/publicBinding"},
        "observed_at_utc": {"$ref": "#/definitions/time"}, "ls_remote_stdout_sha256": {"$ref": "#/definitions/sha256"},
        "observer": {
          "type": "object", "additionalProperties": false,
          "required": ["workflow_repository", "workflow_path", "workflow_ref", "workflow_blob_sha256", "run_id", "run_attempt", "actions_run_projection_sha256"],
          "properties": {
            "workflow_repository": {"const": "Kuberwastaken/c5-k4"},
            "workflow_path": {"const": ".github/workflows/method-v15-p1t-publication-observer.yml"},
            "workflow_ref": {"type": "string", "pattern": "^\\.github/workflows/method-v15-p1t-publication-observer\\.yml@refs/heads/[^ ]+$"},
            "workflow_blob_sha256": {"$ref": "#/definitions/sha256"},
            "run_id": {"type": "integer", "minimum": 1},
            "run_attempt": {"const": 1},
            "actions_run_projection_sha256": {"$ref": "#/definitions/sha256"}
          }
        }
      }
    },
    "activation_policy": {"const": {"structural_draft_only": true, "p1r_is_activation_boundary": false, "p1t_alone_is_activation_boundary": false, "full_exact_c_replay_required": true, "p1r_parent_must_be_exact_p1t": true, "allowed_p1r_changed_paths": ["results/benchmark/v1.5-protocol/P1R.json"], "public_p1r_ref_required": true}}
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitOid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "time": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "fileDigest": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"const": "results/benchmark/v1.5-protocol/P1T.json"}, "sha256": {"$ref": "#/definitions/sha256"}}},
    "publicBinding": {"type": "object", "additionalProperties": false, "required": ["ref", "commit"], "properties": {"ref": {"type": "string", "pattern": "^refs/(?:heads|tags)/[^ ]+$"}, "commit": {"$ref": "#/definitions/gitOid"}}}
  }
}
