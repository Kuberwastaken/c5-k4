{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Kuberwastaken/c5-k4/schemas/benchmark-checkpoint-publication-manifest-v1.5.schema.json",
  "title": "Method v1.5 bounded checkpoint publication manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "artifact_kind", "protocol_version", "scheduled_for_utc", "mode", "public_files", "artifacts", "publication_boundary", "manifest_sha256"],
  "properties": {
    "schema": {"const": "c5k4-method-v1.5-checkpoint-publication-manifest-1.0"},
    "artifact_kind": {"const": "CHECKPOINT_PUBLICATION_MANIFEST"},
    "protocol_version": {"const": "1.5"},
    "scheduled_for_utc": {"$ref": "#/definitions/tick"},
    "mode": {"enum": ["CAPTURE", "TERMINAL_CHRONOLOGY_GAP"]},
    "public_files": {
      "const": ["publication-manifest.json", "quota-certificate.json", "receipt.json"]
    },
    "artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["quota-certificate.json", "receipt.json"],
      "properties": {
        "quota-certificate.json": {"$ref": "#/definitions/publicFile"},
        "receipt.json": {"$ref": "#/definitions/publicFile"}
      }
    },
    "publication_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["identities_present", "statement_text_present", "outcomes_present", "ranking_present", "entropy_present", "logs_present"],
      "properties": {
        "identities_present": {"const": false},
        "statement_text_present": {"const": false},
        "outcomes_present": {"const": false},
        "ranking_present": {"const": false},
        "entropy_present": {"const": false},
        "logs_present": {"const": false}
      }
    },
    "manifest_sha256": {"$ref": "#/definitions/sha"}
  },
  "definitions": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tick": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T00:17:00Z$"},
    "publicFile": {
      "type": "object", "additionalProperties": false,
      "required": ["sha256", "schema"],
      "properties": {
        "sha256": {"$ref": "#/definitions/sha"},
        "schema": {"type": "string", "minLength": 1, "pattern": "^c5k4-method-v1\\.5-"}
      }
    }
  }
}
