{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Kuberwastaken/c5-k4/schemas/benchmark-scheduled-aggregate-certificate-v1.5.schema.json",
  "title": "Method v1.5 scheduled identity-sealed aggregate certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "artifact_kind", "protocol_version", "publication_boundary",
    "checkpoint", "upstream", "chronology", "p1_binding", "component_manifest", "frozen_components", "aggregates",
    "sealed_replay", "certificate_sha256"
  ],
  "properties": {
    "schema": {"const": "c5k4-method-v1.5-scheduled-aggregate-certificate-1.0"},
    "artifact_kind": {"const": "SCHEDULED_AGGREGATE_CERTIFICATE"},
    "protocol_version": {"const": "1.5"},
    "publication_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["identities_present", "statements_present", "outcomes_present", "ranking_present", "entropy_present", "failed_checkpoint_publication"],
      "properties": {
        "identities_present": {"const": false},
        "statements_present": {"const": false},
        "outcomes_present": {"const": false},
        "ranking_present": {"const": false},
        "entropy_present": {"const": false},
        "failed_checkpoint_publication": {"const": "CERTIFICATE_AND_CHRONOLOGY_RECEIPT_ONLY"}
      }
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "scheduled_for_utc", "trigger", "run_attempt", "terminal_horizon"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1},
        "scheduled_for_utc": {"$ref": "#/definitions/timestamp"},
        "trigger": {"const": "schedule"},
        "run_attempt": {"const": 1},
        "terminal_horizon": {"type": "boolean"}
      }
    },
    "upstream": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "ref", "commit", "root_tree", "formal_conjectures_tree"],
      "properties": {
        "repository": {"const": "https://github.com/google-deepmind/formal-conjectures.git"},
        "ref": {"const": "refs/heads/main"},
        "commit": {"$ref": "#/definitions/gitOid"},
        "root_tree": {"$ref": "#/definitions/gitOid"},
        "formal_conjectures_tree": {"$ref": "#/definitions/gitOid"}
      }
    },
    "chronology": {
      "type": "object", "additionalProperties": false,
      "required": ["receipt", "prior_checkpoint_chain_sha256", "all_prior_valid_checkpoints_failed"],
      "properties": {
        "receipt": {"$ref": "#/definitions/artifactRef"},
        "prior_checkpoint_chain_sha256": {"$ref": "#/definitions/sha256"},
        "all_prior_valid_checkpoints_failed": {"const": true}
      }
    },
    "p1_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["p1a", "p1t", "p1a_commit", "p1t_commit"],
      "properties": {
        "p1a": {"$ref": "#/definitions/artifactRef"},
        "p1t": {"$ref": "#/definitions/artifactRef"},
        "p1a_commit": {"$ref": "#/definitions/gitOid"},
        "p1t_commit": {"$ref": "#/definitions/gitOid"}
      }
    },
    "component_manifest": {"$ref": "#/definitions/artifactRef"},
    "frozen_components": {
      "type": "object", "additionalProperties": false,
      "required": ["registry", "classification", "grouping", "syntax_pool", "provenance", "checkpoint_runner", "private_custody", "delivery_broker"],
      "properties": {
        "checkpoint_runner": {
          "type": "object", "additionalProperties": false,
          "required": ["executable", "test", "publication_schema", "private_input_schema", "gap_schema", "public_chain_verifier", "public_chain_proof_schema"],
          "properties": {
            "executable": {"$ref": "#/definitions/artifactRef"}, "test": {"$ref": "#/definitions/artifactRef"},
            "publication_schema": {"$ref": "#/definitions/artifactRef"}, "private_input_schema": {"$ref": "#/definitions/artifactRef"},
            "gap_schema": {"$ref": "#/definitions/artifactRef"}, "public_chain_verifier": {"$ref": "#/definitions/artifactRef"},
            "public_chain_proof_schema": {"$ref": "#/definitions/artifactRef"}
          }
        },
        "private_custody": {
          "type": "object", "additionalProperties": false,
          "required": ["executable", "test", "batch_schema", "coverage_schema", "public_binding_schema"],
          "properties": {
            "executable": {"$ref": "#/definitions/artifactRef"}, "test": {"$ref": "#/definitions/artifactRef"},
            "batch_schema": {"$ref": "#/definitions/artifactRef"}, "coverage_schema": {"$ref": "#/definitions/artifactRef"},
            "public_binding_schema": {"$ref": "#/definitions/artifactRef"}
          }
        },
        "delivery_broker": {
          "type": "object", "additionalProperties": false,
          "required": ["executable", "test", "config_schema", "state_schema", "receipt_schema", "readiness_schema"],
          "properties": {
            "executable": {"$ref": "#/definitions/artifactRef"}, "test": {"$ref": "#/definitions/artifactRef"},
            "config_schema": {"$ref": "#/definitions/artifactRef"}, "state_schema": {"$ref": "#/definitions/artifactRef"},
            "receipt_schema": {"$ref": "#/definitions/artifactRef"}, "readiness_schema": {"$ref": "#/definitions/artifactRef"}
          }
        },
        "registry": {
          "type": "object", "additionalProperties": false,
          "required": ["executable", "policy", "schema", "invocation_contract"],
          "properties": {
            "executable": {"$ref": "#/definitions/artifactRef"}, "policy": {"$ref": "#/definitions/artifactRef"},
            "schema": {"$ref": "#/definitions/artifactRef"}, "invocation_contract": {"$ref": "#/definitions/artifactRef"}
          }
        },
        "classification": {"$ref": "#/definitions/policyComponent"},
        "grouping": {"$ref": "#/definitions/policyComponent"},
        "syntax_pool": {
          "type": "object", "additionalProperties": false, "required": ["executable"],
          "properties": {"executable": {"$ref": "#/definitions/artifactRef"}}
        },
        "provenance": {
          "type": "object", "additionalProperties": false,
          "required": ["classifier", "identity_join", "ontology", "ledger_schema", "content_pack_schema"],
          "properties": {
            "classifier": {"$ref": "#/definitions/artifactRef"}, "identity_join": {"$ref": "#/definitions/artifactRef"},
            "ontology": {"$ref": "#/definitions/artifactRef"}, "ledger_schema": {"$ref": "#/definitions/artifactRef"},
            "content_pack_schema": {"$ref": "#/definitions/artifactRef"}
          }
        }
      }
    },
    "aggregates": {
      "type": "object", "additionalProperties": false,
      "required": ["eligible_by_stratum", "quotas", "deficits", "candidate_count", "status"],
      "properties": {
        "eligible_by_stratum": {"$ref": "#/definitions/fiveCounts"},
        "quotas": {"$ref": "#/definitions/fiveQuotas"},
        "deficits": {"$ref": "#/definitions/fiveCounts"},
        "candidate_count": {"type": "integer", "minimum": 0},
        "status": {"enum": ["PASS", "FAIL"]}
      }
    },
    "sealed_replay": {
      "type": "object", "additionalProperties": false,
      "required": [
        "private_registry_sha256", "private_registry_schema_sha256",
        "runtime_inputs", "aggregate_extractor", "deterministic_exact_byte_replay_required",
        "fresh_isolated_reacquisition_required", "exact_commit_and_trees_required",
        "generic_generated_artifact_verifier_authoritative", "pass_pool_publication"
      ],
      "properties": {
        "private_registry_sha256": {"$ref": "#/definitions/sha256"},
        "private_registry_schema_sha256": {"$ref": "#/definitions/sha256"},
        "runtime_inputs": {
          "type": "object", "additionalProperties": false,
          "required": ["provenance_ledgers", "provenance_content_pack_sha256"],
          "properties": {
            "provenance_ledgers": {
              "type": "array", "minItems": 1,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["position", "file_sha256", "ledger_sha256"],
                "properties": {
                  "position": {"type": "integer", "minimum": 0},
                  "file_sha256": {"$ref": "#/definitions/sha256"},
                  "ledger_sha256": {"$ref": "#/definitions/sha256"}
                }
              }
            },
            "provenance_content_pack_sha256": {"$ref": "#/definitions/sha256"}
          }
        },
        "aggregate_extractor": {"$ref": "#/definitions/artifactRef"},
        "deterministic_exact_byte_replay_required": {"const": true},
        "fresh_isolated_reacquisition_required": {"const": true},
        "exact_commit_and_trees_required": {"const": true},
        "generic_generated_artifact_verifier_authoritative": {"const": false},
        "pass_pool_publication": {"const": "SEPARATE_PRE_ENTROPY_ARTIFACT"}
      }
    },
    "certificate_sha256": {"$ref": "#/definitions/sha256"}
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitOid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T00:17:00Z$"},
    "artifactRef": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(scripts|schemas|results/benchmark/v1\\.5-[A-Za-z0-9._/-]+)/[^\\u0000]*$"},
        "sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "policyComponent": {
      "type": "object", "additionalProperties": false, "required": ["policy"],
      "properties": {"policy": {"$ref": "#/definitions/artifactRef"}}
    },
    "fiveCounts": {
      "type": "object", "additionalProperties": false,
      "required": ["GRAPH_SCALAR_INEQUALITY", "GRAPH_STRUCTURAL_PROPERTY", "FINITE_ALGEBRA_EQUATIONAL", "AUTOMATA_GAME_PROCESS", "FINITE_COMBINATORIAL"],
      "properties": {
        "GRAPH_SCALAR_INEQUALITY": {"type": "integer", "minimum": 0},
        "GRAPH_STRUCTURAL_PROPERTY": {"type": "integer", "minimum": 0},
        "FINITE_ALGEBRA_EQUATIONAL": {"type": "integer", "minimum": 0},
        "AUTOMATA_GAME_PROCESS": {"type": "integer", "minimum": 0},
        "FINITE_COMBINATORIAL": {"type": "integer", "minimum": 0}
      }
    },
    "fiveQuotas": {
      "type": "object", "additionalProperties": false,
      "required": ["GRAPH_SCALAR_INEQUALITY", "GRAPH_STRUCTURAL_PROPERTY", "FINITE_ALGEBRA_EQUATIONAL", "AUTOMATA_GAME_PROCESS", "FINITE_COMBINATORIAL"],
      "properties": {
        "GRAPH_SCALAR_INEQUALITY": {"const": 3},
        "GRAPH_STRUCTURAL_PROPERTY": {"const": 3},
        "FINITE_ALGEBRA_EQUATIONAL": {"const": 2},
        "AUTOMATA_GAME_PROCESS": {"const": 2},
        "FINITE_COMBINATORIAL": {"const": 2}
      }
    }
  }
}
