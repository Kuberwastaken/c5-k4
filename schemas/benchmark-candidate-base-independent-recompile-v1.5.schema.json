{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Kuberwastaken/c5-k4/schemas/benchmark-candidate-base-independent-recompile-v1.5.schema.json",
  "title": "Method v1.5 independently signed candidate-base recompile attestation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "protocol_version", "payload_sha256", "closure_aggregate_sha256", "operational_evidence_bundle_sha256", "authority_root_commit", "authority_root_sha256", "compiler_closure_sha256", "validator_sha256", "execution_id", "execution_host_id", "completed_at_utc", "signer", "attestation_sha256", "signature"],
  "properties": {
    "schema": {"const": "c5k4-method-v1.5-candidate-base-independent-recompile-1.0"},
    "status": {"const": "INDEPENDENT_EXACT_C_RECOMPILE_PASSED"},
    "protocol_version": {"const": "1.5"},
    "payload_sha256": {"$ref": "#/definitions/sha256"},
    "closure_aggregate_sha256": {"$ref": "#/definitions/sha256"},
    "operational_evidence_bundle_sha256": {"$ref": "#/definitions/sha256"},
    "authority_root_commit": {"$ref": "#/definitions/gitOid"},
    "authority_root_sha256": {"$ref": "#/definitions/sha256"},
    "compiler_closure_sha256": {"$ref": "#/definitions/sha256"},
    "validator_sha256": {"$ref": "#/definitions/sha256"},
    "execution_id": {"$ref": "#/definitions/id"},
    "execution_host_id": {"$ref": "#/definitions/id"},
    "completed_at_utc": {"$ref": "#/definitions/time"},
    "signer": {
      "type": "object", "additionalProperties": false, "required": ["signer_class", "signer_id", "verification_key_sha256"],
      "properties": {"signer_class": {"const": "INDEPENDENT_RECOMPILER"}, "signer_id": {"$ref": "#/definitions/id"}, "verification_key_sha256": {"$ref": "#/definitions/sha256"}}
    },
    "attestation_sha256": {"$ref": "#/definitions/sha256"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitOid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+-]{0,127}$"},
    "time": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"}
  }
}
