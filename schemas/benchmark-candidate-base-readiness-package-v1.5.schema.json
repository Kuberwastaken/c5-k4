{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Kuberwastaken/c5-k4/schemas/benchmark-candidate-base-readiness-package-v1.5.schema.json",
  "title": "Method v1.5 replayable signed candidate-base readiness package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "protocol_version", "candidate", "authority_root", "closures", "operational_evidence", "compiler", "structural_json_key_audit", "payload_sha256", "authority_signatures", "independent_recompiles", "package_sha256"],
  "properties": {
    "schema": {"const": "c5k4-method-v1.5-candidate-base-readiness-package-1.0"},
    "status": {"const": "SIGNED_TARGET_BLIND_READINESS_AWAITING_PUBLIC_P1R"},
    "protocol_version": {"const": "1.5"},
    "candidate": {"$ref": "#/definitions/gitBinding"},
    "authority_root": {"$ref": "#/definitions/authorityBinding"},
    "closures": {
      "type": "object", "additionalProperties": false,
      "required": ["native", "inherited", "full_source", "aggregate_sha256"],
      "properties": {
        "native": {"$ref": "#/definitions/closure"}, "inherited": {"$ref": "#/definitions/closure"},
        "full_source": {"$ref": "#/definitions/closure"}, "aggregate_sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "operational_evidence": {"$ref": "#/definitions/embeddedJson"},
    "compiler": {
      "type": "object", "additionalProperties": false,
      "required": ["validator", "input_schema", "output_schema", "authority_root_schema", "operational_evidence_schema", "independent_recompile_schema", "readiness_package_schema", "p1r_schema", "activation_receipt_schema", "isolated_evidence_runner", "isolated_evidence_runner_schema", "isolated_evidence_runner_contract", "isolated_evidence_runner_test"],
      "properties": {
        "validator": {"$ref": "#/definitions/fileDigest"}, "input_schema": {"$ref": "#/definitions/fileDigest"},
        "output_schema": {"$ref": "#/definitions/fileDigest"}, "authority_root_schema": {"$ref": "#/definitions/fileDigest"},
        "operational_evidence_schema": {"$ref": "#/definitions/fileDigest"}, "independent_recompile_schema": {"$ref": "#/definitions/fileDigest"},
        "readiness_package_schema": {"$ref": "#/definitions/fileDigest"}, "p1r_schema": {"$ref": "#/definitions/fileDigest"},
        "activation_receipt_schema": {"$ref": "#/definitions/fileDigest"},
        "isolated_evidence_runner": {"$ref": "#/definitions/fileDigest"},
        "isolated_evidence_runner_schema": {"$ref": "#/definitions/fileDigest"},
        "isolated_evidence_runner_contract": {"$ref": "#/definitions/fileDigest"},
        "isolated_evidence_runner_test": {"$ref": "#/definitions/fileDigest"}
      }
    },
    "structural_json_key_audit": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "scope", "json_blob_count", "candidate_identities_keys_detected", "statement_text_keys_detected", "target_rankings_keys_detected", "target_semantic_analysis_keys_detected", "does_not_claim_free_text_or_python_semantic_audit"],
      "properties": {
        "algorithm": {"const": "STRUCTURAL_JSON_KEY_AUDIT_V1_5"},
        "scope": {"const": ["V1_5_NATIVE_JSON_BLOBS", "V1_4_SELECTED_INHERITED_JSON_BLOBS", "V1_4_FULL_P0A_REFERENCED_JSON_BLOBS"]},
        "json_blob_count": {"type": "integer", "minimum": 1},
        "candidate_identities_keys_detected": {"const": 0}, "statement_text_keys_detected": {"const": 0},
        "target_rankings_keys_detected": {"const": 0}, "target_semantic_analysis_keys_detected": {"const": 0},
        "does_not_claim_free_text_or_python_semantic_audit": {"const": true}
      }
    },
    "payload_sha256": {"$ref": "#/definitions/sha256"},
    "authority_signatures": {
      "type": "array", "minItems": 2,
      "items": {"$ref": "#/definitions/signature"}
    },
    "independent_recompiles": {
      "type": "array", "minItems": 2,
      "items": {"$ref": "#/definitions/embeddedJson"}
    },
    "package_sha256": {"$ref": "#/definitions/sha256"}
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitOid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+-]{0,127}$"},
    "repoPath": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"},
    "fileDigest": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/definitions/repoPath"}, "sha256": {"$ref": "#/definitions/sha256"}}},
    "gitBinding": {"type": "object", "additionalProperties": false, "required": ["commit", "root_tree"], "properties": {"commit": {"$ref": "#/definitions/gitOid"}, "root_tree": {"$ref": "#/definitions/gitOid"}}},
    "authorityBinding": {"type": "object", "additionalProperties": false, "required": ["commit", "root_tree", "path", "sha256"], "properties": {"commit": {"$ref": "#/definitions/gitOid"}, "root_tree": {"$ref": "#/definitions/gitOid"}, "path": {"$ref": "#/definitions/repoPath"}, "sha256": {"$ref": "#/definitions/sha256"}}},
    "closure": {"type": "object", "additionalProperties": false, "required": ["row_count", "sha256"], "properties": {"row_count": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/definitions/sha256"}}},
    "embeddedJson": {
      "type": "object", "additionalProperties": false,
      "required": ["encoding", "canonical_json_base64", "sha256"],
      "properties": {
        "encoding": {"const": "BASE64_CANONICAL_JSON_UTF8"},
        "canonical_json_base64": {"type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"},
        "sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["signer_class", "signer_id", "verification_key_sha256", "algorithm", "signature"],
      "properties": {
        "signer_class": {"enum": ["CONTROLLED_HARNESS_READINESS_KEY", "FROZEN_EXPERIMENTER_IDENTITY"]},
        "signer_id": {"$ref": "#/definitions/id"}, "verification_key_sha256": {"$ref": "#/definitions/sha256"},
        "algorithm": {"const": "Ed25519"}, "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
      }
    }
  }
}
