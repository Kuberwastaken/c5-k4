{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Kuberwastaken/c5-k4/schemas/benchmark-scheduled-replay-attestation-v1.5.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "status", "certificate_sha256", "chronology_receipt_sha256", "private_registry_sha256", "registry_unsigned_projection_sha256", "upstream", "verifier", "attestation_sha256"],
  "properties": {
    "schema": {"const": "c5k4-method-v1.5-scheduled-replay-attestation-1.0"},
    "status": {"const": "INDEPENDENT_EXACT_REPLAY_PASS"},
    "certificate_sha256": {"$ref": "#/definitions/sha256"},
    "chronology_receipt_sha256": {"$ref": "#/definitions/sha256"},
    "private_registry_sha256": {"$ref": "#/definitions/sha256"},
    "registry_unsigned_projection_sha256": {"$ref": "#/definitions/sha256"},
    "upstream": {"type": "object", "additionalProperties": false, "required": ["commit", "root_tree", "formal_conjectures_tree"], "properties": {"commit": {"$ref": "#/definitions/gitOid"}, "root_tree": {"$ref": "#/definitions/gitOid"}, "formal_conjectures_tree": {"$ref": "#/definitions/gitOid"}}},
    "verifier": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"const": "scripts/build_benchmark_v15_aggregate_certificate.py"}, "sha256": {"$ref": "#/definitions/sha256"}}},
    "attestation_sha256": {"$ref": "#/definitions/sha256"}
  },
  "definitions": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "gitOid": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}
}
