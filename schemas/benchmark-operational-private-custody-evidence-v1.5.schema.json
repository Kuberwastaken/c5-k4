{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Kuberwastaken/c5-k4/schemas/benchmark-operational-private-custody-evidence-v1.5.schema.json",
  "title": "Method v1.5 operational custody evidence accepted by the private assembler",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "status", "protocol_version", "verification_mode", "participant_ledger_sha256", "source_boundary_sha256", "noninterference_receipt_sha256", "store_acceptance_sha256", "service_epoch_binding_sha256", "required_from_utc", "required_through_utc", "maximum_heartbeat_interval_seconds", "required_hosts", "host_chains", "complete", "gaps", "certificate_sha256"],
      "properties": {
        "schema": {"const": "c5k4-method-v1.5-private-custody-coverage-certificate-1.0"},
        "status": {"const": "FROZEN_P1_CUSTODY_COVERAGE_VALID"},
        "protocol_version": {"const": "1.5"},
        "verification_mode": {"const": "TARGET_BLIND_METADATA_ONLY"},
        "participant_ledger_sha256": {"$ref": "#/definitions/sha256"},
        "source_boundary_sha256": {"$ref": "#/definitions/sha256"},
        "noninterference_receipt_sha256": {"$ref": "#/definitions/sha256"},
        "store_acceptance_sha256": {"$ref": "#/definitions/sha256"},
        "service_epoch_binding_sha256": {"$ref": "#/definitions/sha256"},
        "required_from_utc": {"$ref": "#/definitions/timestamp"},
        "required_through_utc": {"$ref": "#/definitions/timestamp"},
        "maximum_heartbeat_interval_seconds": {"const": 300},
        "required_hosts": {"const": ["ai-vps-controlled-harness"]},
        "host_chains": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/hostChain"}},
        "complete": {"const": true},
        "gaps": {"const": []},
        "certificate_sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "status", "protocol_version", "disclosure", "seal_algorithm", "sealed_private_bundle_sha256", "sealed_private_bundle_byte_count", "private_coverage_certificate_sha256", "participant_ledger_sha256", "source_boundary_sha256", "noninterference_receipt_sha256", "store_acceptance_sha256", "service_epoch_binding_sha256", "required_host_count", "required_from_utc", "required_through_utc", "binding_sha256"],
      "properties": {
        "schema": {"const": "c5k4-method-v1.5-public-custody-sealed-binding-1.0"},
        "status": {"const": "FROZEN_P1_PUBLIC_BINDING_VALID"},
        "protocol_version": {"const": "1.5"},
        "disclosure": {"const": "TARGET_BLIND_HASHES_AND_COVERAGE_ONLY"},
        "seal_algorithm": {"const": "FROZEN_P1_OPAQUE_AUTHENTICATED_ENVELOPE_V1"},
        "sealed_private_bundle_sha256": {"$ref": "#/definitions/sha256"},
        "sealed_private_bundle_byte_count": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "private_coverage_certificate_sha256": {"$ref": "#/definitions/sha256"},
        "participant_ledger_sha256": {"$ref": "#/definitions/sha256"},
        "source_boundary_sha256": {"$ref": "#/definitions/sha256"},
        "noninterference_receipt_sha256": {"$ref": "#/definitions/sha256"},
        "store_acceptance_sha256": {"$ref": "#/definitions/sha256"},
        "service_epoch_binding_sha256": {"$ref": "#/definitions/sha256"},
        "required_host_count": {"const": 1},
        "required_from_utc": {"$ref": "#/definitions/timestamp"},
        "required_through_utc": {"$ref": "#/definitions/timestamp"},
        "binding_sha256": {"$ref": "#/definitions/sha256"}
      }
    }
  ],
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "sequence": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "hostChain": {
      "type": "object", "additionalProperties": false,
      "required": ["host_id", "signing_key_id", "first_batch_sequence", "last_batch_sequence", "first_record_sequence", "last_record_sequence", "first_observed_at_utc", "last_observed_at_utc", "batch_count", "record_count", "last_batch_sha256", "last_receipt_sha256", "maximum_observed_gap_seconds", "restart_count", "chain_complete"],
      "properties": {
        "host_id": {"$ref": "#/definitions/id"},
        "signing_key_id": {"$ref": "#/definitions/id"},
        "first_batch_sequence": {"$ref": "#/definitions/sequence"},
        "last_batch_sequence": {"$ref": "#/definitions/sequence"},
        "first_record_sequence": {"$ref": "#/definitions/sequence"},
        "last_record_sequence": {"$ref": "#/definitions/sequence"},
        "first_observed_at_utc": {"$ref": "#/definitions/timestamp"},
        "last_observed_at_utc": {"$ref": "#/definitions/timestamp"},
        "batch_count": {"type": "integer", "minimum": 1},
        "record_count": {"type": "integer", "minimum": 1},
        "last_batch_sha256": {"$ref": "#/definitions/sha256"},
        "last_receipt_sha256": {"$ref": "#/definitions/sha256"},
        "maximum_observed_gap_seconds": {"type": "integer", "minimum": 0, "maximum": 300},
        "restart_count": {"type": "integer", "minimum": 0},
        "chain_complete": {"const": true}
      }
    }
  }
}
