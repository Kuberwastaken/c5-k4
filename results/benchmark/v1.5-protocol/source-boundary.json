      "stop": "only after cutoff endpoint acquisition",
      "gap_or_overflow": "FAIL_CLOSED"
    },
    "session_sync": {
      "maximum_expected_interval_seconds": 300,
      "local_and_archive_required": true,
      "sequence_receipts_required": true,
      "gap_or_newer_wins_conflict": "FAIL_CLOSED"
