{
  "schema_version": "c5k4-registry-build-invocation-contract-1.4",
  "authority": "P0_PROTOCOL_COMPONENT",
  "protocol_version": "1.4",
  "producer_id": "method-v1.4-production-registry-builder",
  "executable": "scripts/build_benchmark_v14_registry.py",
  "input_schema": "schemas/benchmark-registry-input-v1.4.schema.json",
  "output_schema": "schemas/benchmark-registry-output-v1.4.schema.json",
  "preflight_command": [
    "python3",
    "scripts/build_benchmark_v14_registry.py",
    "preflight",
    "--input",
    "${PREFLIGHT_INPUT_JSON}",
    "--receipt-dir",
    "${NEW_ABSENT_RECEIPT_DIRECTORY}"
  ],
  "build_command": [
    "python3",
    "scripts/build_benchmark_v14_registry.py",
    "build",
    "--input",
    "${INPUT_JSON}",
    "--formal-repo",
    "${PINNED_FORMAL_CONJECTURES_CHECKOUT}",
    "--output-dir",
    "${NEW_ABSENT_OUTPUT_DIRECTORY}"
  ],
  "path_parameters": {
    "PREFLIGHT_INPUT_JSON": "a bounded non-semantic request containing the frozen P0T remote and upstream rule",
    "NEW_ABSENT_RECEIPT_DIRECTORY": "an absent path receiving the exact raw P0T-advertisement and upstream-materialization receipts",
    "INPUT_JSON": "one file validating against the frozen input schema and binding both preflight receipts",
    "PINNED_FORMAL_CONJECTURES_CHECKOUT": "the preregistered fresh bare repository /home/ec2-user/.local/share/c5k4-v14-formal-conjectures.git materialized by preflight",
    "NEW_ABSENT_OUTPUT_DIRECTORY": "an absent path created atomically and exclusively by the producer"
  },
  "timestamp_semantics": {
    "registry_build_invoked_at_utc": "recorded in the build input immediately before the offline build starts",
    "registry_build_completed_at_utc": "observed by the offline producer after all six artifacts and replay checks are complete and before atomic publication",
    "required_order": "S0 <= public start <= public completion <= upstream fetch start <= upstream fetch completion <= registry_build_invoked_at_utc <= registry_build_completed_at_utc",
    "receipt_times": "observed by the preflight immediately around each network subprocess; callers do not supply them"
  },
  "registry_exemption_input": {
    "p0_component_role": "registry_exemption_rule",
    "schema_version": "c5k4-registry-exemption-rule-1.4",
    "scope": "only already-existing pre-P0 bounded machine registry units present at exact S0 source locators",
    "unit_identity": ["source_id", "source_kind", "locator", "role", "content_sha256", "content_schema"],
    "global_content_hash_allowlist": false,
    "future_production_outputs_exempted": false,
    "missing_or_mismatched_s0_unit_policy": "FAIL_CLOSED"
  },
  "execution": {
    "allowed_build_count": 1,
    "build_ordinal": 1,
    "requires_public_p0t": true,
    "requires_complete_s0": true,
    "network_boundary": {
      "preflight": {
        "default": "FORBIDDEN",
        "allowed_calls": [
        {
          "purpose": "VERIFY_PUBLIC_P0T_ADVERTISEMENT",
          "command_prefix": ["/usr/bin/git", "-c", "core.hooksPath=/dev/null", "-c", "core.fsmonitor=false", "-c", "diff.external=", "-c", "diff.trustExitCode=false", "-c", "filter.lfs.process=", "-c", "filter.lfs.smudge=", "-c", "filter.lfs.required=false", "-c", "protocol.version=2", "-c", "http.followRedirects=false", "ls-remote"],
          "remote": "https://github.com/Kuberwastaken/c5-k4.git",
          "maximum_calls": 1,
          "scientific_data_returned": false
        },
        {
          "purpose": "SOLE_UPSTREAM_RESOLUTION_AND_MATERIALIZATION",
          "command": [
            "/usr/bin/git",
            "-c",
            "core.hooksPath=/dev/null",
            "-c",
            "core.fsmonitor=false",
            "-c",
            "diff.external=",
            "-c",
            "diff.trustExitCode=false",
            "-c",
            "filter.lfs.process=",
            "-c",
            "filter.lfs.smudge=",
            "-c",
            "filter.lfs.required=false",
            "-c",
            "protocol.version=2",
            "-c",
            "http.followRedirects=false",
            "-c",
            "fetch.fsckObjects=true",
            "-c",
            "transfer.fsckObjects=true",
            "-C",
            "/home/ec2-user/.local/share/c5k4-v14-formal-conjectures.git",
            "fetch",
            "--porcelain",
            "--atomic",
            "--no-tags",
            "--no-recurse-submodules",
            "--no-write-fetch-head",
            "--no-auto-maintenance",
            "--no-auto-gc",
            "--no-write-commit-graph",
            "--no-progress",
            "--refmap=",
            "https://github.com/google-deepmind/formal-conjectures.git",
            "refs/heads/main:refs/c5k4-benchmark/v1.4/upstream-main"
          ],
          "maximum_calls": 1,
          "required_porcelain_new_ref_rows": 1,
          "materializes_commit_tree_and_subtree": true
        }
        ],
        "total_maximum_calls": 2,
        "retry_permitted": false,
        "redirect_to_unfrozen_remote_permitted": false,
        "raw_receipts_content_addressed": true,
        "subprocess_environment": {
          "HOME": "/nonexistent",
          "LANG": "C",
          "LC_ALL": "C",
          "GIT_CONFIG_GLOBAL": "/dev/null",
          "GIT_CONFIG_NOSYSTEM": "1",
          "GIT_CONFIG_SYSTEM": "/dev/null",
          "GIT_NO_LAZY_FETCH": "1",
          "GIT_NO_REPLACE_OBJECTS": "1",
          "GIT_TERMINAL_PROMPT": "0",
          "GIT_ASKPASS": "/bin/false",
          "SSH_ASKPASS": "/bin/false"
        }
      },
      "production_build": {
        "network_permitted": false,
        "receipt_replay_required": true,
        "receipt_drift_policy": "FAIL_CLOSED",
        "git_environment": {
          "HOME": "/nonexistent",
          "LANG": "C",
          "LC_ALL": "C",
          "GIT_CONFIG_GLOBAL": "/dev/null",
          "GIT_CONFIG_NOSYSTEM": "1",
          "GIT_CONFIG_SYSTEM": "/dev/null",
          "GIT_NO_LAZY_FETCH": "1",
          "GIT_NO_REPLACE_OBJECTS": "1",
          "GIT_TERMINAL_PROMPT": "0",
          "GIT_ASKPASS": "/bin/false",
          "SSH_ASKPASS": "/bin/false"
        }
      }
    },
    "stdin_permitted": false,
    "environment_as_scientific_input_permitted": false,
    "entropy_permitted": false,
    "selection_or_ranking_permitted": false,
    "prototype_inputs_permitted": false,
    "overwrite_permitted": false,
    "create_exclusive_output_directory": true
  },
  "required_output_files": [
    "registry-build-output.json",
    "open-inventory.json",
    "question-cluster-pool.json",
    "provenance-inventory.json",
    "contamination-inventory.json",
    "eligible-cluster-pool.json",
    "quota-feasibility.json"
  ],
  "output_artifact_ids": [
    "open_inventory",
    "question_cluster_pool",
    "provenance_inventory",
    "contamination_inventory",
    "eligible_pool",
    "quota_feasibility"
  ],
  "validation": {
    "file_sha256_construction": "SHA256_OF_EXACT_FILE_BYTES",
    "canonical_sha256_construction": "SHA256_OF_UTF8_JSON_SORT_KEYS_COMPACT_SEPARATORS_NO_TRAILING_NEWLINE_WITH_INTERNAL_SELF_DIGEST_FIELD_OMITTED_WHEN_PRESENT",
    "input_schema_before_any_target_read": true,
    "all_input_file_and_canonical_digests_recomputed": true,
    "p0t_and_s0_chronology_replayed": true,
    "upstream_commit_tree_and_subtree_replayed": true,
    "output_schema_before_success": true,
    "six_output_file_and_canonical_digests_recomputed": true,
    "eligible_intersection_replayed_row_by_row": true,
    "feasibility_counts_deficits_surpluses_and_status_replayed_row_by_row": true,
    "output_self_digest_replayed_with_output_sha256_omitted": true,
    "any_failure_leaves_no_authoritative_output": true
  },
  "forbidden_output": [
    "statement_text",
    "mathematical_interpretation",
    "candidate_witness",
    "proof_or_disproof_route",
    "random_rank",
    "selected_target"
  ]
}
