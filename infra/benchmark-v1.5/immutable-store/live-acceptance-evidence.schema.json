{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Kuberwastaken/c5-k4/infra/benchmark-v1.5/immutable-store/live-acceptance-evidence.schema.json",
  "title": "Method v1.5 private target-blind immutable-store authenticated live evidence v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "visibility", "source", "acquired_at_utc", "account_id",
    "region", "receipt_sha256", "receipt_authentication", "bindings", "stack", "resource_identities",
    "s3", "kms", "iam", "destructive_probes", "target_specific"
  ],
  "properties": {
    "schema": {"const": "c5k4-method-v1.5-immutable-store-live-evidence-1.1"},
    "status": {"const": "LIVE_ACCEPTANCE_EVIDENCE_CAPTURE"},
    "visibility": {"const": "PRIVATE_ACCEPTANCE_EVIDENCE"},
    "source": {"enum": ["AWS_MIXED_READ_PROBE_CAPTURE", "INJECTED_TEST_FIXTURE"]},
    "acquired_at_utc": {"$ref": "#/definitions/timestamp"},
    "account_id": {"type": "string", "pattern": "^[0-9]{12}$"},
    "region": {"const": "ap-south-1"},
    "receipt_sha256": {"$ref": "#/definitions/sha256"},
    "receipt_authentication": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "signing_key_id", "signature_algorithm", "verification_key_sha256", "signed_payload_sha256", "signature_base64"],
      "properties": {
        "schema": {"const": "c5k4-method-v1.5-immutable-store-evidence-signature-1.0"},
        "signing_key_id": {"$ref": "#/definitions/id"},
        "signature_algorithm": {"const": "Ed25519"},
        "verification_key_sha256": {"$ref": "#/definitions/sha256"},
        "signed_payload_sha256": {"$ref": "#/definitions/sha256"},
        "signature_base64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
      }
    },
    "bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["template_sha256", "kms_key_policy_sha256", "bucket_policy_sha256", "writer_policy_sha256", "store_config_sha256"],
      "properties": {
        "template_sha256": {"$ref": "#/definitions/sha256"},
        "kms_key_policy_sha256": {"$ref": "#/definitions/sha256"},
        "bucket_policy_sha256": {"$ref": "#/definitions/sha256"},
        "writer_policy_sha256": {"$ref": "#/definitions/sha256"},
        "store_config_sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "stack": {
      "type": "object", "additionalProperties": false,
      "required": ["stack_id", "status", "termination_protection", "drift_status", "deployed_template", "resources", "state_capture_phase"],
      "properties": {
        "stack_id": {"type": "string", "pattern": "^arn:aws:cloudformation:ap-south-1:[0-9]{12}:stack/[A-Za-z0-9-]+/[0-9a-f-]+$"},
        "status": {"enum": ["CREATE_COMPLETE", "UPDATE_COMPLETE"]},
        "termination_protection": {"const": true},
        "drift_status": {"const": "IN_SYNC"},
        "deployed_template": {"type": "object"},
        "resources": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/definitions/stackResource"}},
        "state_capture_phase": {"const": "AFTER_DESTRUCTIVE_PROBES"}
      }
    },
    "resource_identities": {
      "type": "object", "additionalProperties": false,
      "required": ["bucket", "kms_key_id", "kms_key_arn", "writer_role_arn", "writer_policy_name"],
      "properties": {
        "bucket": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"},
        "kms_key_id": {"type": "string", "pattern": "^[0-9a-f-]{36}$"},
        "kms_key_arn": {"type": "string", "pattern": "^arn:aws:kms:ap-south-1:[0-9]{12}:key/[0-9a-f-]{36}$"},
        "writer_role_arn": {"type": "string", "pattern": "^arn:aws:iam::[0-9]{12}:role/c5k4/v1\\.5/[A-Za-z0-9+=,.@_-]+$"},
        "writer_policy_name": {"const": "c5k4-v1-5-private-custody-single-writer"}
      }
    },
    "s3": {
      "type": "object", "additionalProperties": false,
      "required": ["retention_years", "probe_canary", "versioning", "object_lock", "encryption", "public_access_block", "policy_status", "policy_document", "tags"],
      "properties": {
        "retention_years": {"type": "integer", "minimum": 3, "maximum": 10},
        "probe_canary": {
          "type": "object", "additionalProperties": false,
          "required": ["key", "version_id", "sha256", "retain_until_utc", "exists", "delete_marker_present"],
          "properties": {
            "key": {"const": "private/c5k4/v1.5/acceptance/immutable-store-canary"},
            "version_id": {"type": "string", "minLength": 1, "maxLength": 1024},
            "sha256": {"$ref": "#/definitions/sha256"}, "retain_until_utc": {"$ref": "#/definitions/timestamp"},
            "exists": {"const": true}, "delete_marker_present": {"const": false}
          }
        },
        "versioning": {"type": "object"}, "object_lock": {"type": "object"},
        "encryption": {"type": "object"}, "public_access_block": {"type": "object"},
        "policy_status": {"type": "object"}, "policy_document": {"type": "object"},
        "tags": {"type": "array"}
      }
    },
    "kms": {
      "type": "object", "additionalProperties": false,
      "required": ["metadata", "rotation_enabled", "policy_document", "tags"],
      "properties": {
        "metadata": {"type": "object"}, "rotation_enabled": {"const": true},
        "policy_document": {"type": "object"}, "tags": {"type": "array"}
      }
    },
    "iam": {
      "type": "object", "additionalProperties": false,
      "required": ["trusted_harness_principal_arn", "trusted_harness_external_id", "role", "trust_policy_document", "boundary_policy_document", "inline_policy_document", "inline_policy_names", "attached_policy_arns"],
      "properties": {
        "trusted_harness_principal_arn": {"type": "string", "pattern": "^arn:aws:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]+$"},
        "trusted_harness_external_id": {"type": "string", "minLength": 32, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$"},
        "role": {"type": "object"}, "trust_policy_document": {"type": "object"},
        "boundary_policy_document": {"type": "object"}, "inline_policy_document": {"type": "object"},
        "inline_policy_names": {"const": ["c5k4-v1-5-private-custody-single-writer"]},
        "attached_policy_arns": {"const": []}
      }
    },
    "destructive_probes": {
      "type": "array", "minItems": 9, "maxItems": 9,
      "items": {"$ref": "#/definitions/probe"}
    },
    "target_specific": {"const": false}
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "stackResource": {
      "type": "object", "additionalProperties": false,
      "required": ["logical_id", "physical_id", "type", "status", "drift_status"],
      "properties": {
        "logical_id": {"type": "string"}, "physical_id": {"type": "string"},
        "type": {"type": "string"}, "status": {"enum": ["CREATE_COMPLETE", "UPDATE_COMPLETE"]},
        "drift_status": {"const": "IN_SYNC"}
      }
    },
    "probe": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "caller", "request", "request_sha256", "result", "result_sha256", "pre_state", "pre_state_sha256", "post_state", "post_state_sha256"],
      "properties": {
        "operation": {"type": "string"},
        "caller": {"enum": ["CUSTODY_WRITER", "NON_WRITER_ACCOUNT_PRINCIPAL"]},
        "request": {"type": "object"}, "request_sha256": {"$ref": "#/definitions/sha256"},
        "result": {"type": "object"}, "result_sha256": {"$ref": "#/definitions/sha256"},
        "pre_state": {"type": "object"}, "pre_state_sha256": {"$ref": "#/definitions/sha256"},
        "post_state": {"type": "object"}, "post_state_sha256": {"$ref": "#/definitions/sha256"}
      }
    }
  }
}
